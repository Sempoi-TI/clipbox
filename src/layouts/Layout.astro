<style>
	/* ── Dark theme (default) ── */
	:root {
		--bg-gradient:    radial-gradient(circle at 50% 0%, #1a1b26 0%, #0f1016 100%);
		--bg-page:        #0f1016;
		--bg-card:        rgba(22, 24, 37, 0.7);
		--bg-card-solid:  #14161f;
		--bg-input:       rgba(15, 16, 22, 0.6);
		--bg-hover:       rgba(255, 255, 255, 0.05);
		--border-color:   rgba(255, 255, 255, 0.08);
		--border-focus:   rgba(99, 102, 241, 0.5);
		--text-primary:   #f3f4f6;
		--text-secondary: #d1d5db;
		--text-muted:     #9ca3af;
		--text-faint:     rgba(255, 255, 255, 0.2);
		--scrollbar-track: #0f1016;
		--scrollbar-thumb: #2d3142;
		--scrollbar-hover: #40455c;
		--glass-bg:       rgba(22, 24, 37, 0.6);
		--glass-border:   rgba(255, 255, 255, 0.08);
		--primary:        #6366f1;
		--primary-hover:  #4f46e5;
		--primary-glow:   rgba(99, 102, 241, 0.3);
		--font-sans: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
		--font-title: 'Plus Jakarta Sans', var(--font-sans);
	}

	/* ── Light theme ── */
	html.light {
		--bg-gradient:    radial-gradient(circle at 50% 0%, #eef0ff 0%, #f5f5fa 100%);
		--bg-page:        #f5f5fa;
		--bg-card:        rgba(255, 255, 255, 0.85);
		--bg-card-solid:  #ffffff;
		--bg-input:       rgba(255, 255, 255, 0.9);
		--bg-hover:       rgba(99, 102, 241, 0.05);
		--border-color:   rgba(0, 0, 0, 0.08);
		--border-focus:   rgba(99, 102, 241, 0.4);
		--text-primary:   #111827;
		--text-secondary: #374151;
		--text-muted:     #6b7280;
		--text-faint:     rgba(0, 0, 0, 0.2);
		--scrollbar-track: #e5e7eb;
		--scrollbar-thumb: #c4c9d4;
		--scrollbar-hover: #9ca3af;
		--glass-bg:       rgba(255, 255, 255, 0.7);
		--glass-border:   rgba(99, 102, 241, 0.15);
		--primary:        #6366f1;
		--primary-hover:  #4f46e5;
		--primary-glow:   rgba(99, 102, 241, 0.2);
	}

	html, body {
		margin: 0;
		padding: 0;
		width: 100%;
		min-height: 100vh;
		font-family: var(--font-sans);
		background: var(--bg-gradient);
		color: var(--text-primary);
		overflow-x: hidden;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
		transition: background 0.3s, color 0.3s;
	}

	/* Scrollbar styling */
	::-webkit-scrollbar { width: 8px; height: 8px; }
	::-webkit-scrollbar-track  { background: var(--scrollbar-track); }
	::-webkit-scrollbar-thumb  { background: var(--scrollbar-thumb); border-radius: 4px; }
	::-webkit-scrollbar-thumb:hover { background: var(--scrollbar-hover); }
</style>
