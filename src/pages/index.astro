---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import SnippetForm from '../components/SnippetForm.astro';
import SearchFilter from '../components/SearchFilter.astro';
import SnippetCardTemplate from '../components/SnippetCardTemplate.astro';
import categories from '../data/categories.json';
---

<Layout>
	<main class="app-container">
		<div class="toast-container" id="toast-container"></div>

		<section class="auth-screen" id="auth-screen">
			<div class="auth-shell">
				<div class="auth-intro">
					<div class="auth-brand">
						<div class="auth-brand-icon">
							<svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
						</div>
						<div>
							<h1>ClipBox</h1>
							<p>Guarda, organiza y encuentra tus textos favoritos desde una sola interfaz.</p>
						</div>
					</div>
					<ul class="auth-features">
						<li>Acceso seguro desde tu cuenta personal</li>
						<li>Organización simple para tus fragmentos y enlaces</li>
						<li>Experiencia rápida en escritorio y móvil</li>
					</ul>
				</div>

				<div class="auth-card glass-card">
					<div class="auth-toolbar">
						<button id="auth-theme-toggle" class="theme-toggle" type="button" title="Cambiar tema" aria-label="Cambiar tema">
							<svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
							<svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
						</button>
					</div>

					<div class="auth-mode-switch" role="tablist" aria-label="Cambiar formulario de autenticación">
						<button type="button" class="auth-mode-btn is-active" id="auth-login-tab" data-auth-mode="login">Iniciar sesión</button>
						<button type="button" class="auth-mode-btn" id="auth-register-tab" data-auth-mode="register">Crear cuenta</button>
					</div>

					<h2 id="auth-card-title">Iniciar sesión</h2>
					<p class="auth-copy" id="auth-card-copy">Entra para continuar con tu biblioteca personal.</p>
					<p class="auth-feedback" id="auth-feedback" hidden></p>

					<form id="auth-login-form" class="auth-form">
						<div class="form-group">
							<label for="auth-login-email">Email</label>
							<input type="email" id="auth-login-email" autocomplete="email" placeholder="tu@email.com" required />
						</div>
						<div class="form-group">
							<label for="auth-login-password">Contraseña</label>
							<input type="password" id="auth-login-password" autocomplete="current-password" placeholder="Tu contraseña" required />
						</div>
						<button type="submit" class="btn btn-save auth-submit-btn" id="auth-login-submit-btn">
							Entrar
						</button>
					</form>

					<form id="auth-register-form" class="auth-form" hidden>
						<div class="form-group">
							<label for="auth-register-email">Email</label>
							<input type="email" id="auth-register-email" autocomplete="email" placeholder="tu@email.com" required />
						</div>
						<div class="form-group">
							<label for="auth-register-password">Contraseña</label>
							<input type="password" id="auth-register-password" autocomplete="new-password" placeholder="Crea una contraseña" required />
						</div>
						<div class="form-group">
							<label for="auth-register-password-confirm">Confirmar contraseña</label>
							<input type="password" id="auth-register-password-confirm" autocomplete="new-password" placeholder="Repite la contraseña" required />
						</div>
						<button type="submit" class="btn btn-save auth-submit-btn" id="auth-register-submit-btn">
							Crear cuenta
						</button>
					</form>
				</div>
			</div>
		</section>

		<section id="app-shell" hidden>
			<Header />

			<div class="session-bar glass-card">
				<div class="session-copy">
					<span class="session-label">Sesión activa</span>
					<strong id="session-user-email">-</strong>
				</div>
				<button type="button" class="session-logout-btn" id="logout-button">Cerrar sesión</button>
			</div>

			<div class="app-grid">
				<aside class="editor-panel">
					<SnippetForm />
				</aside>

				<section class="list-panel">
					<SearchFilter />

					<div class="snippets-grid" id="snippets-container">
						<div class="loading-state">Cargando snippets...</div>
					</div>
				</section>
			</div>

			<div class="snippet-preview-tooltip" id="snippet-preview-tooltip" aria-hidden="true"></div>
			
			<div class="modal-backdrop" id="edit-modal" aria-hidden="true">
				<div class="modal-box glass-card">
					<div class="modal-header">
						<h2>Edit Snippet</h2>
						<button class="modal-close-btn" id="modal-close-btn" title="Close">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
						</button>
					</div>
					<form id="edit-form" class="snippet-form">
						<input type="hidden" id="edit-snippet-id" />
						<div class="form-group">
							<label for="edit-snippet-text">Content</label>
							<textarea id="edit-snippet-text" rows="5" required></textarea>
						</div>
						<div class="form-group">
							<label for="edit-snippet-description">Description (Optional)</label>
							<input type="text" id="edit-snippet-description" placeholder="Add a short description..." autocomplete="off" />
						</div>
						<div class="form-group">
							<label>Tags (Optional)</label>
							<div class="tag-input-wrapper" id="edit-tag-input-wrapper">
								<div class="tag-chips-row" id="edit-tag-chips-row"></div>
								<input type="text" id="edit-snippet-tags-input" placeholder="Type a tag and press Enter..." autocomplete="off" />
							</div>
							<span class="tag-hint">Press <kbd>Enter</kbd> or <kbd>,</kbd> to add a tag</span>
						</div>
						<div class="form-group">
							<label for="edit-snippet-category">Category</label>
							<select id="edit-snippet-category">
								{categories.map(cat => (
									<option value={cat.value}>{cat.label}</option>
								))}
							</select>
						</div>
						<div class="modal-actions">
							<button type="button" class="btn btn-cancel" id="modal-cancel-btn">Cancel</button>
							<button type="submit" class="btn btn-save">
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
								Save Changes
							</button>
						</div>
					</form>
				</div>
			</div>

			<div class="modal-backdrop" id="variables-modal" aria-hidden="true">
				<div class="modal-box glass-card modal-box-compact">
					<div class="modal-header">
						<h2>Completar variables</h2>
						<button class="modal-close-btn" id="variables-modal-close-btn" title="Close">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
						</button>
					</div>
					<form id="variables-form" class="snippet-form">
						<p class="variables-modal-copy">Rellena los valores para generar el texto final antes de copiarlo.</p>
						<div class="variables-fields" id="variables-fields"></div>
						<div class="modal-actions">
							<button type="button" class="btn btn-cancel" id="variables-modal-cancel-btn">Cancelar</button>
							<button type="submit" class="btn btn-save">
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
								Copiar texto
							</button>
						</div>
					</form>
				</div>
			</div>

			<SnippetCardTemplate />
		</section>
	</main>
</Layout>

<script>
	// @ts-nocheck
	import { supabase } from '../scripts/supabase-client';
	import categoriesData from '../data/categories.json';

	const CATEGORIES = categoriesData;
	const VIEW_ICON_GRID = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect></svg>`;
	const VIEW_ICON_LIST = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>`;
	const SNIPPET_VARIABLE_REGEX = /\{\{\s*([^{}]+?)\s*\}\}/g;

	let sortOrderAscending = true;
	let snippets = [];
	let currentFilter = 'all';
	let searchQuery = '';
	let viewMode = 'grid';
	let currentTags = [];
	let editTags = [];

	let form = null;
	let textInput = null;
	let descriptionInput = null;
	let categorySelect = null;
	let tagsInput = null;
	let tagChipsRow = null;
	let searchInput = null;
	let snippetsContainer = null;
	let filterButtons = document.querySelectorAll('.filter-btn');
	let exportButton = null;
	let toastContainer = null;
	let template = null;
	let currentSession = null;
	let sessionUserId = null;
	let appBootstrapped = false;

	const authScreen = document.getElementById('auth-screen');
	const appShell = document.getElementById('app-shell');
	const authCardTitle = document.getElementById('auth-card-title');
	const authCardCopy = document.getElementById('auth-card-copy');
	const authFeedback = document.getElementById('auth-feedback');
	const authModeButtons = document.querySelectorAll('[data-auth-mode]');
	const authLoginForm = document.getElementById('auth-login-form');
	const authRegisterForm = document.getElementById('auth-register-form');
	const authLoginEmailInput = document.getElementById('auth-login-email');
	const authLoginPasswordInput = document.getElementById('auth-login-password');
	const authRegisterEmailInput = document.getElementById('auth-register-email');
	const authRegisterPasswordInput = document.getElementById('auth-register-password');
	const authRegisterPasswordConfirmInput = document.getElementById('auth-register-password-confirm');
	const authLoginSubmitBtn = document.getElementById('auth-login-submit-btn');
	const authRegisterSubmitBtn = document.getElementById('auth-register-submit-btn');
	const sessionUserEmail = document.getElementById('session-user-email');
	const logoutButton = document.getElementById('logout-button');

	const variablesModal = document.getElementById('variables-modal');
	const variablesForm = document.getElementById('variables-form');
	const variablesFields = document.getElementById('variables-fields');
	const variablesModalCloseBtn = document.getElementById('variables-modal-close-btn');
	const variablesModalCancelBtn = document.getElementById('variables-modal-cancel-btn');

	const editModal = document.getElementById('edit-modal');
	const editForm = document.getElementById('edit-form');
	const editIdInput = document.getElementById('edit-snippet-id');
	const editTextInput = document.getElementById('edit-snippet-text');
	const editDescInput = document.getElementById('edit-snippet-description');
	const editCategorySelect = document.getElementById('edit-snippet-category');
	const editTagsInput = document.getElementById('edit-snippet-tags-input');
	const editTagChipsRow = document.getElementById('edit-tag-chips-row');

	const snippetPreviewTooltip = document.getElementById('snippet-preview-tooltip');

	let pendingCopyButton = null;
	let pendingCopyText = '';
	let activePreviewAnchor = null;
	let authMode = 'login';

	function initDomElements() {
		form = document.getElementById('snippet-form');
		textInput = document.getElementById('snippet-text');
		descriptionInput = document.getElementById('snippet-description');
		categorySelect = document.getElementById('snippet-category');
		tagsInput = document.getElementById('snippet-tags-input');
		tagChipsRow = document.getElementById('tag-chips-row');
		searchInput = document.getElementById('search-input');
		snippetsContainer = document.getElementById('snippets-container');
		filterButtons = document.querySelectorAll('.filter-btn');
		exportButton = document.getElementById('export-snippets-button');
		toastContainer = document.getElementById('toast-container');
		template = document.getElementById('snippet-card-template');
	}

	function setAuthFeedback(message = '', type = 'info') {
		if (!authFeedback) return;
		authFeedback.hidden = !message;
		authFeedback.textContent = message;
		authFeedback.dataset.state = type;
	}

	function applyTheme(theme) {
		if (theme === 'light') {
			document.documentElement.classList.add('light');
		} else {
			document.documentElement.classList.remove('light');
		}
		localStorage.setItem('clipbox_theme', theme);
		updateThemeToggleState();
	}

	function updateThemeToggleState() {
		const authThemeToggle = document.getElementById('auth-theme-toggle');
		if (!authThemeToggle) return;
		const isLight = document.documentElement.classList.contains('light');
		authThemeToggle.setAttribute('aria-pressed', String(isLight));
		authThemeToggle.setAttribute('title', isLight ? 'Cambiar a tema oscuro' : 'Cambiar a tema claro');
		authThemeToggle.setAttribute('aria-label', isLight ? 'Cambiar a tema oscuro' : 'Cambiar a tema claro');
	}

	function showAuthMode(mode = 'login') {
		authMode = mode === 'register' ? 'register' : 'login';
		const isRegisterMode = authMode === 'register';

		authLoginForm?.toggleAttribute('hidden', isRegisterMode);
		authRegisterForm?.toggleAttribute('hidden', !isRegisterMode);

		if (authCardTitle) {
			authCardTitle.textContent = isRegisterMode ? 'Crear cuenta' : 'Iniciar sesión';
		}

		if (authCardCopy) {
			authCardCopy.textContent = isRegisterMode
				? 'Crea tu cuenta para empezar a guardar tus snippets.'
				: 'Entra para continuar con tu biblioteca personal.';
		}

		authModeButtons.forEach((button) => {
			const isActive = button.getAttribute('data-auth-mode') === authMode;
			button.classList.toggle('is-active', isActive);
			button.setAttribute('aria-selected', String(isActive));
		});

		setAuthFeedback('');
	}

	function setAuthPending(isPending) {
		if (authLoginSubmitBtn) {
			authLoginSubmitBtn.disabled = isPending;
			authLoginSubmitBtn.textContent = isPending ? 'Procesando...' : 'Entrar';
		}
		if (authRegisterSubmitBtn) {
			authRegisterSubmitBtn.disabled = isPending;
			authRegisterSubmitBtn.textContent = isPending ? 'Procesando...' : 'Crear cuenta';
		}
		if (authLoginEmailInput) authLoginEmailInput.disabled = isPending;
		if (authLoginPasswordInput) authLoginPasswordInput.disabled = isPending;
		if (authRegisterEmailInput) authRegisterEmailInput.disabled = isPending;
		if (authRegisterPasswordInput) authRegisterPasswordInput.disabled = isPending;
		if (authRegisterPasswordConfirmInput) authRegisterPasswordConfirmInput.disabled = isPending;
	}

	function ensureAppBindings() {
		if (appBootstrapped) return;
		loadViewMode();
		wireTagInputs();
		wireExportButton();
		wireViewToggle();
		wireSortButton();
		wireCreateForm();
		wireEditForm();
		wireVariablesModal();
		wireModalCloseEvents();
		wireSearchAndFilters();
		appBootstrapped = true;
	}

	function updateAuthVisibility(session) {
		const isLoggedIn = Boolean(session);
		authScreen?.toggleAttribute('hidden', isLoggedIn);
		appShell?.toggleAttribute('hidden', !isLoggedIn);

		if (sessionUserEmail) {
			sessionUserEmail.textContent = session?.user?.email || 'Usuario autenticado';
		}
	}

	function renderLoadError() {
		if (!snippetsContainer) return;
		snippetsContainer.innerHTML = `
			<div class="empty-state">
				<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
				<p>No fue posible cargar tus snippets en este momento.</p>
			</div>
		`;
	}

	async function syncAuthenticatedApp(session) {
		currentSession = session;
		updateAuthVisibility(session);

		if (!session) {
			sessionUserId = null;
			snippets = [];
			setAuthPending(false);
			return;
		}

		ensureAppBindings();
		const nextUserId = session.user?.id || null;
		if (sessionUserId === nextUserId && snippets.length > 0) return;
		sessionUserId = nextUserId;

		try {
			await loadSnippets();
			renderSnippets();
		} catch (error) {
			console.error('Snippet load failed', error);
			renderLoadError();
			showToast('No fue posible cargar tus snippets', 'error');
		}
	}

	async function handleAuthSubmit(event) {
		event.preventDefault();
		const email = authLoginEmailInput?.value.trim() || '';
		const password = authLoginPasswordInput?.value || '';
		if (!email || !password) return;

		setAuthFeedback('');
		setAuthPending(true);
		const { error } = await supabase.auth.signInWithPassword({ email, password });
		setAuthPending(false);

		if (error) {
			setAuthFeedback(error.message, 'error');
			showToast('No se pudo iniciar sesión', 'error');
			return;
		}

		authLoginForm?.reset();
		setAuthFeedback('');
		showToast('Sesión iniciada correctamente', 'success');
	}

	async function handleRegisterSubmit(event) {
		event.preventDefault();
		const email = authRegisterEmailInput?.value.trim() || '';
		const password = authRegisterPasswordInput?.value || '';
		const passwordConfirm = authRegisterPasswordConfirmInput?.value || '';
		if (!email || !password || !passwordConfirm) {
			setAuthFeedback('Completa todos los campos del registro.', 'error');
			return;
		}

		if (password !== passwordConfirm) {
			setAuthFeedback('Las contraseñas no coinciden.', 'error');
			return;
		}

		if (password.length < 6) {
			setAuthFeedback('La contraseña debe tener al menos 6 caracteres.', 'error');
			return;
		}

		setAuthFeedback('');
		setAuthPending(true);
		const { data, error } = await supabase.auth.signUp({ email, password });
		setAuthPending(false);

		if (error) {
			setAuthFeedback(error.message, 'error');
			showToast('No se pudo crear la cuenta', 'error');
			return;
		}

		if (data.session) {
			authRegisterForm?.reset();
			setAuthFeedback('');
			showToast('Cuenta creada correctamente', 'success');
			return;
		}

		setAuthFeedback('Cuenta creada. Revisa tu correo si tienes confirmación de email activada.', 'info');
		authRegisterForm?.reset();
		showAuthMode('login');
		showToast('Cuenta creada. Revisa tu correo para confirmarla', 'info');
	}

	async function handleLogout() {
		const { error } = await supabase.auth.signOut();
		if (error) {
			showToast('No se pudo cerrar la sesión', 'error');
			return;
		}

		setAuthFeedback('');
		showToast('Sesión cerrada', 'info');
	}

	function wireAuthEvents() {
		authLoginForm?.addEventListener('submit', handleAuthSubmit);
		authRegisterForm?.addEventListener('submit', handleRegisterSubmit);
		authModeButtons.forEach((button) => {
			button.addEventListener('click', () => showAuthMode(button.getAttribute('data-auth-mode') || 'login'));
		});
		document.getElementById('auth-theme-toggle')?.addEventListener('click', () => {
			const isLight = document.documentElement.classList.contains('light');
			applyTheme(isLight ? 'dark' : 'light');
		});
		logoutButton?.addEventListener('click', handleLogout);
	}

	function normalizeSnippet(row) {
		return {
			id: row.id ?? '',
			userId: row.user_id ?? null,
			orderNumber: Number.isFinite(Number(row.order_number)) ? Number(row.order_number) : 0,
			text: row.text ?? '',
			description: row.description || undefined,
			tags: Array.isArray(row.tags) ? row.tags.filter(Boolean) : [],
			category: row.category || 'Code',
			pinned: Boolean(row.pinned)
		};
	}

	function getSnippetPayload({ userId, orderNumber, text, description, tags, category, pinned }) {
		return {
			user_id: userId,
			order_number: orderNumber,
			text,
			description: description || null,
			tags: tags.length > 0 ? tags : [],
			category,
			pinned: Boolean(pinned)
		};
	}

	function getNextOrderNumber() {
		const maxOrderNumber = snippets.reduce((max, snippet) => Math.max(max, Number(snippet.orderNumber) || 0), 0);
		return maxOrderNumber + 1;
	}

	function renderFormTags() {
		if (!tagChipsRow) return;
		tagChipsRow.innerHTML = '';
		currentTags.forEach((tag, i) => {
			const chip = document.createElement('span');
			chip.className = 'form-tag-chip';
			chip.textContent = tag;
			const removeBtn = document.createElement('button');
			removeBtn.type = 'button';
			removeBtn.className = 'form-tag-remove';
			removeBtn.title = 'Remove tag';
			removeBtn.textContent = '×';
			removeBtn.addEventListener('click', () => {
				currentTags.splice(i, 1);
				renderFormTags();
			});
			chip.appendChild(removeBtn);
			tagChipsRow.appendChild(chip);
		});
	}

	function renderEditTags() {
		if (!editTagChipsRow) return;
		editTagChipsRow.innerHTML = '';
		editTags.forEach((tag, i) => {
			const chip = document.createElement('span');
			chip.className = 'form-tag-chip';
			chip.textContent = tag;
			const removeBtn = document.createElement('button');
			removeBtn.type = 'button';
			removeBtn.className = 'form-tag-remove';
			removeBtn.title = 'Remove tag';
			removeBtn.textContent = '×';
			removeBtn.addEventListener('click', () => {
				editTags.splice(i, 1);
				renderEditTags();
			});
			chip.appendChild(removeBtn);
			editTagChipsRow.appendChild(chip);
		});
	}

	function sanitizeTag(raw) {
		return raw.trim().toLowerCase().replace(/[^a-z0-9_-]/g, '');
	}

	function addTag(raw) {
		const tag = sanitizeTag(raw);
		if (tag && !currentTags.includes(tag)) {
			currentTags.push(tag);
			renderFormTags();
		}
	}

	function addEditTag(raw) {
		const tag = sanitizeTag(raw);
		if (tag && !editTags.includes(tag)) {
			editTags.push(tag);
			renderEditTags();
		}
	}

	function wireTagInputs() {
		if (tagsInput) {
			tagsInput.addEventListener('keydown', (e) => {
				if (e.key === 'Enter' || e.key === ',') {
					e.preventDefault();
					addTag(tagsInput.value);
					tagsInput.value = '';
				} else if (e.key === 'Backspace' && tagsInput.value === '' && currentTags.length > 0) {
					currentTags.pop();
					renderFormTags();
				}
			});

			tagsInput.addEventListener('blur', () => {
				if (tagsInput.value.trim()) {
					addTag(tagsInput.value);
					tagsInput.value = '';
				}
			});
		}

		if (editTagsInput) {
			editTagsInput.addEventListener('keydown', (e) => {
				if (e.key === 'Enter' || e.key === ',') {
					e.preventDefault();
					addEditTag(editTagsInput.value);
					editTagsInput.value = '';
				} else if (e.key === 'Backspace' && editTagsInput.value === '' && editTags.length > 0) {
					editTags.pop();
					renderEditTags();
				}
			});

			editTagsInput.addEventListener('blur', () => {
				if (editTagsInput.value.trim()) {
					addEditTag(editTagsInput.value);
					editTagsInput.value = '';
				}
			});
		}
	}

	function loadViewMode() {
		const saved = localStorage.getItem('clipbox_view_mode');
		viewMode = saved === 'list' ? 'list' : 'grid';
		applyViewMode();
	}

	function applyViewMode() {
		if (!snippetsContainer) return;
		snippetsContainer.classList.toggle('view-list', viewMode === 'list');

		const btn = document.getElementById('view-toggle-btn');
		if (btn) {
			const isListView = viewMode === 'list';
			btn.classList.toggle('is-list', isListView);
			btn.setAttribute('title', isListView ? 'Cambiar a vista de grilla' : 'Cambiar a vista de lista');
			btn.setAttribute('aria-label', isListView ? 'Cambiar a vista de grilla' : 'Cambiar a vista de lista');
			const icon = document.getElementById('view-toggle-icon');
			if (icon) icon.innerHTML = isListView ? VIEW_ICON_GRID : VIEW_ICON_LIST;
		}
	}

	function wireViewToggle() {
		const btn = document.getElementById('view-toggle-btn');
		if (!btn) return;
		btn.addEventListener('click', () => {
			viewMode = viewMode === 'grid' ? 'list' : 'grid';
			localStorage.setItem('clipbox_view_mode', viewMode);
			applyViewMode();
		});
	}

	function updateSortButtonUI() {
		const sortBtn = document.getElementById('sort-order-btn');
		const text = document.getElementById('sort-order-text');
		if (!sortBtn || !text) return;

		sortBtn.classList.toggle('sort-asc', sortOrderAscending);
		sortBtn.classList.toggle('sort-desc', !sortOrderAscending);
		sortBtn.setAttribute('aria-pressed', String(sortOrderAscending));
		text.textContent = sortOrderAscending ? 'Ascendente' : 'Descendente';
	}

	function wireSortButton() {
		const sortBtn = document.getElementById('sort-order-btn');
		if (!sortBtn) return;
		updateSortButtonUI();
		sortBtn.addEventListener('click', () => {
			sortOrderAscending = !sortOrderAscending;
			updateSortButtonUI();
			renderSnippets();
		});
	}

	async function loadSnippets() {
		if (snippetsContainer) {
			snippetsContainer.innerHTML = '<div class="loading-state">Cargando snippets...</div>';
		}

		if (!sessionUserId) {
			snippets = [];
			return;
		}

		const { data, error } = await supabase
			.from('snippets')
			.select('id, user_id, order_number, text, description, tags, category, pinned')
			.eq('user_id', sessionUserId);

		if (error) {
			throw error;
		}

		snippets = (data ?? []).map(normalizeSnippet);
	}

	function wireExportButton() {
		if (!exportButton) return;
		exportButton.addEventListener('click', exportSnippetsToClipboard);
	}

	async function exportSnippetsToClipboard() {
		try {
			const exportText = JSON.stringify(snippets, null, 2);
			await navigator.clipboard.writeText(exportText);
			showToast(`Exported ${snippets.length} snippets to clipboard!`, 'success');
		} catch (error) {
			console.error('Export failed', error);
			showToast('Failed to copy JSON to clipboard', 'error');
		}
	}

	function showToast(message, type = 'success') {
		if (!toastContainer) return;
		const toast = document.createElement('div');
		toast.className = `toast toast-${type}`;

		let icon = '';
		if (type === 'success') {
			icon = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>`;
		} else if (type === 'info') {
			icon = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>`;
		} else {
			icon = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>`;
		}

		toast.innerHTML = `
			<span class="toast-icon">${icon}</span>
			<span class="toast-message">${message}</span>
		`;

		toastContainer.appendChild(toast);
		setTimeout(() => toast.classList.add('visible'), 10);

		setTimeout(() => {
			toast.classList.remove('visible');
			const removeToast = () => toast.remove();
			toast.addEventListener('transitionend', removeToast, { once: true });
			setTimeout(removeToast, 350);
		}, 2000);
	}

	async function copyToClipboard(text, button) {
		try {
			await navigator.clipboard.writeText(text);
			const originalHTML = button.innerHTML;
			button.classList.add('copied');
			button.innerHTML = `
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
			`;

			showToast('Text copied to clipboard!', 'success');

			setTimeout(() => {
				button.classList.remove('copied');
				button.innerHTML = originalHTML;
			}, 2000);
		} catch (error) {
			showToast('Error to copy text', 'error');
		}
	}

	function extractSnippetVariables(text) {
		const variables = [];
		const seen = new Set();
		for (const match of text.matchAll(SNIPPET_VARIABLE_REGEX)) {
			const name = match[1].trim();
			if (!name || seen.has(name)) continue;
			seen.add(name);
			variables.push(name);
		}
		return variables;
	}

	function resolveSnippetVariables(text, values) {
		return text.replace(SNIPPET_VARIABLE_REGEX, (_, rawName) => {
			const name = rawName.trim();
			return Object.prototype.hasOwnProperty.call(values, name) ? values[name] : '';
		});
	}

	function closeVariablesModal() {
		if (!variablesModal || !variablesFields) return;
		variablesModal.classList.remove('open');
		variablesModal.setAttribute('aria-hidden', 'true');
		variablesFields.innerHTML = '';
		pendingCopyButton = null;
		pendingCopyText = '';
	}

	function openVariablesModal(text, button) {
		if (!variablesModal || !variablesFields) {
			copyToClipboard(text, button);
			return;
		}

		const variables = extractSnippetVariables(text);
		if (variables.length === 0) {
			copyToClipboard(text, button);
			return;
		}

		pendingCopyButton = button;
		pendingCopyText = text;
		variablesFields.innerHTML = '';

		variables.forEach((name) => {
			const field = document.createElement('div');
			field.className = 'form-group variables-field';

			const label = document.createElement('label');
			label.className = 'variables-label';
			const inputId = `variable-input-${name.toLowerCase().replace(/[^a-z0-9_-]+/g, '-')}`;
			label.setAttribute('for', inputId);
			label.textContent = name;

			const input = document.createElement('input');
			input.type = 'text';
			input.id = inputId;
			input.name = name;
			input.className = 'variables-input';
			input.placeholder = `Valor para ${name}`;
			input.autocomplete = 'off';
			input.required = true;

			field.appendChild(label);
			field.appendChild(input);
			variablesFields.appendChild(field);
		});

		variablesModal.classList.add('open');
		variablesModal.setAttribute('aria-hidden', 'false');
		setTimeout(() => variablesFields.querySelector('input')?.focus(), 50);
	}

	async function handleSnippetCopy(text, button) {
		const variables = extractSnippetVariables(text);
		if (variables.length === 0) {
			await copyToClipboard(text, button);
			return;
		}
		openVariablesModal(text, button);
	}

	function closeEditModal() {
		if (!editModal) return;
		editModal.classList.remove('open');
		editModal.setAttribute('aria-hidden', 'true');
		editTags = [];
		if (editTagsInput) editTagsInput.value = '';
	}

	function openEditModal(id) {
		const snippet = snippets.find((item) => item.id === id);
		if (!snippet || !editModal || !editIdInput || !editTextInput || !editDescInput || !editCategorySelect) return;

		editIdInput.value = String(snippet.id);
		editTextInput.value = snippet.text;
		editDescInput.value = snippet.description || '';
		editCategorySelect.value = snippet.category;
		editTags = [...(snippet.tags || [])];
		renderEditTags();
		editModal.setAttribute('aria-hidden', 'false');
		editModal.classList.add('open');
		setTimeout(() => editTextInput.focus(), 50);
	}

	async function deleteSnippet(id) {
		if (!sessionUserId) return;
		const { error } = await supabase
			.from('snippets')
			.delete()
			.eq('id', id)
			.eq('user_id', sessionUserId);
		if (error) {
			console.error('Delete failed', error);
			showToast('Failed to delete snippet', 'error');
			return;
		}

		snippets = snippets.filter((snippet) => snippet.id !== id);
		renderSnippets();
		showToast('Snippet deleted', 'info');
	}

	async function togglePin(id) {
		if (!sessionUserId) return;
		const snippet = snippets.find((item) => item.id === id);
		if (!snippet) return;

		const nextPinned = !snippet.pinned;
		const { error } = await supabase
			.from('snippets')
			.update({ pinned: nextPinned })
			.eq('id', id)
			.eq('user_id', sessionUserId);

		if (error) {
			console.error('Pin update failed', error);
			showToast('Failed to update pin status', 'error');
			return;
		}

		snippet.pinned = nextPinned;
		renderSnippets();
		showToast(nextPinned ? 'Snippet pinned!' : 'Snippet unpinned', nextPinned ? 'success' : 'info');
	}

	function getCategoryBadge(category) {
		const categoryData = CATEGORIES.find((cat) => cat.value === category);
		if (categoryData) {
			return { label: `${categoryData.emoji} ${categoryData.label}`, class: categoryData.badge };
		}
		return { label: '👺 All', class: 'badge-all' };
	}

	function getSnippetUrl(text) {
		const trimmed = text.trim();
		if (!trimmed) return null;
		if (/^https?:\/\//i.test(trimmed)) return trimmed;
		try {
			const url = new URL(trimmed.startsWith('//') ? `https:${trimmed}` : `https://${trimmed}`);
			return url.href;
		} catch {
			return null;
		}
	}

	function isSnippetLink(snippet) {
		return snippet.category === 'Link' && getSnippetUrl(snippet.text) !== null;
	}

	function isSnippetContentTruncated(element) {
		if (!element) return false;
		const codeElement = element.querySelector('code');
		const verticalOverflow = element.scrollHeight - element.clientHeight > 1;
		const horizontalOverflow = element.scrollWidth - element.clientWidth > 1;
		const nestedHorizontalOverflow = codeElement
			? (codeElement.scrollWidth - codeElement.clientWidth > 1) || (codeElement.scrollWidth - element.clientWidth > 1)
			: false;
		const nestedVerticalOverflow = codeElement
			? (codeElement.scrollHeight - codeElement.clientHeight > 1) || (codeElement.scrollHeight - element.clientHeight > 1)
			: false;
		return verticalOverflow || horizontalOverflow || nestedHorizontalOverflow || nestedVerticalOverflow;
	}

	function positionSnippetPreviewTooltip(anchor) {
		if (!snippetPreviewTooltip || !anchor) return;
		const padding = 12;
		const offset = 10;
		const anchorRect = anchor.getBoundingClientRect();
		const tooltipRect = snippetPreviewTooltip.getBoundingClientRect();

		let top = anchorRect.bottom + offset;
		if (top + tooltipRect.height > window.innerHeight - padding) {
			top = Math.max(padding, anchorRect.top - tooltipRect.height - offset);
		}

		let left = anchorRect.left;
		if (left + tooltipRect.width > window.innerWidth - padding) {
			left = window.innerWidth - tooltipRect.width - padding;
		}
		left = Math.max(padding, left);

		snippetPreviewTooltip.style.top = `${top}px`;
		snippetPreviewTooltip.style.left = `${left}px`;
	}

	function hideSnippetPreviewTooltip() {
		if (!snippetPreviewTooltip) return;
		snippetPreviewTooltip.classList.remove('visible');
		snippetPreviewTooltip.setAttribute('aria-hidden', 'true');
		activePreviewAnchor = null;
	}

	function showSnippetPreviewTooltip(text, anchor) {
		if (!snippetPreviewTooltip || !anchor) return;
		snippetPreviewTooltip.textContent = text;
		snippetPreviewTooltip.setAttribute('aria-hidden', 'false');
		activePreviewAnchor = anchor;
		positionSnippetPreviewTooltip(anchor);
		snippetPreviewTooltip.classList.add('visible');
	}

	window.addEventListener('resize', () => {
		if (!activePreviewAnchor) return;
		if (!isSnippetContentTruncated(activePreviewAnchor)) {
			hideSnippetPreviewTooltip();
			return;
		}
		positionSnippetPreviewTooltip(activePreviewAnchor);
	});

	document.addEventListener('scroll', () => {
		if (!activePreviewAnchor) return;
		positionSnippetPreviewTooltip(activePreviewAnchor);
	}, true);

	function renderSnippets() {
		if (!snippetsContainer) return;

		const normalizedSearch = searchQuery.trim().toLowerCase();
		const filtered = snippets.filter((snippet) => {
			const matchesCategory = currentFilter === 'all' || snippet.category === currentFilter;
			const matchesSearch = !normalizedSearch ||
				snippet.text.toLowerCase().includes(normalizedSearch) ||
				(snippet.description && snippet.description.toLowerCase().includes(normalizedSearch)) ||
				(snippet.tags && snippet.tags.some((tag) => tag.toLowerCase().includes(normalizedSearch))) ||
				snippet.category.toLowerCase().includes(normalizedSearch);

			return matchesCategory && matchesSearch;
		});

		filtered.sort((a, b) => {
			const orderDelta = sortOrderAscending
				? a.orderNumber - b.orderNumber
				: b.orderNumber - a.orderNumber;
			if (orderDelta !== 0) return orderDelta;
			return String(a.id).localeCompare(String(b.id));
		});

		if (filtered.length === 0) {
			snippetsContainer.innerHTML = `
				<div class="empty-state">
					<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="8" y1="12" x2="16" y2="12"></line></svg>
					<p>No se encontraron snippets que coincidan con la búsqueda.</p>
				</div>
			`;
			return;
		}

		snippetsContainer.innerHTML = '';
		const pinned = filtered.filter((snippet) => snippet.pinned);
		const rest = filtered.filter((snippet) => !snippet.pinned);

		[...pinned, ...rest].forEach((snippet) => {
			snippetsContainer.appendChild(buildCard(snippet));
		});
	}

	function buildCard(snippet) {
		const badge = getCategoryBadge(snippet.category);
		const clone = document.importNode(template.content, true);
		const card = clone.querySelector('.snippet-card');

		if (snippet.pinned && card) card.classList.add('is-pinned');

		const badgeEl = clone.querySelector('.category-badge');
		if (badgeEl) {
			badgeEl.textContent = badge.label;
			badgeEl.className = `category-badge ${badge.class}`;
		}

		const descEl = clone.querySelector('.snippet-description');
		if (descEl) {
			if (snippet.description) {
				descEl.textContent = snippet.description;
				descEl.style.display = 'block';
			} else {
				descEl.style.display = 'none';
			}
		}

		const contentEl = clone.querySelector('.snippet-content');
		const codeEl = clone.querySelector('code');
		if (codeEl) {
			codeEl.textContent = snippet.text;
		}
		if (contentEl) {
			contentEl.addEventListener('mouseenter', () => {
				if (!isSnippetContentTruncated(contentEl)) return;
				showSnippetPreviewTooltip(snippet.text, contentEl);
			});
			contentEl.addEventListener('mouseleave', hideSnippetPreviewTooltip);
		}

		const tagsEl = clone.querySelector('.snippet-tags');
		if (tagsEl && snippet.tags.length > 0) {
			snippet.tags.forEach((tag) => {
				const chip = document.createElement('span');
				chip.className = 'tag-chip';
				chip.textContent = tag;
				tagsEl.appendChild(chip);
			});
		}

		const pinBtn = clone.querySelector('.pin-btn');
		if (pinBtn) {
			if (snippet.pinned) pinBtn.classList.add('pinned');
			pinBtn.title = snippet.pinned ? 'Unpin snippet' : 'Pin snippet';
			pinBtn.addEventListener('click', () => togglePin(snippet.id));
		}

		const copyBtn = clone.querySelector('.copy-btn');
		if (copyBtn) {
			copyBtn.addEventListener('click', () => handleSnippetCopy(snippet.text, copyBtn));
		}

		const openLinkBtn = clone.querySelector('.open-link-btn');
		if (openLinkBtn) {
			const url = getSnippetUrl(snippet.text);
			if (isSnippetLink(snippet) && url) {
				openLinkBtn.href = url;
				openLinkBtn.hidden = false;
			} else {
				openLinkBtn.hidden = true;
			}
		}

		const editBtn = clone.querySelector('.edit-btn');
		if (editBtn) {
			editBtn.addEventListener('click', () => openEditModal(snippet.id));
		}

		const deleteBtn = clone.querySelector('.delete-btn');
		if (deleteBtn) {
			deleteBtn.addEventListener('click', () => deleteSnippet(snippet.id));
		}

		return clone;
	}

	function resetCreateForm() {
		if (textInput) textInput.value = '';
		if (descriptionInput) descriptionInput.value = '';
		currentTags = [];
		renderFormTags();
	}

	function wireCreateForm() {
		if (!form || !textInput || !categorySelect) return;
		form.addEventListener('submit', async (e) => {
			e.preventDefault();

			const text = textInput.value.trim();
			const description = descriptionInput ? descriptionInput.value.trim() : '';
			if (tagsInput && tagsInput.value.trim()) {
				addTag(tagsInput.value);
				tagsInput.value = '';
			}
			const tags = [...currentTags];
			const category = categorySelect.value;

			if (!text) return;

			const payload = getSnippetPayload({
				userId: sessionUserId,
				orderNumber: getNextOrderNumber(),
				text,
				description,
				tags,
				category,
				pinned: false
			});

			const { data, error } = await supabase
				.from('snippets')
				.insert(payload)
				.select('id, user_id, order_number, text, description, tags, category, pinned')
				.single();

			if (error) {
				console.error('Create failed', error);
				showToast('Failed to create snippet', 'error');
				return;
			}

			snippets.unshift(normalizeSnippet(data));
			renderSnippets();
			resetCreateForm();
			showToast('Snippet created successfully!', 'success');
		});
	}

	function wireEditForm() {
		if (!editForm || !editIdInput || !editTextInput || !editCategorySelect) return;
		editForm.addEventListener('submit', async (e) => {
			e.preventDefault();

			const id = editIdInput.value;
			const text = editTextInput.value.trim();
			if (!text) return;

			if (editTagsInput && editTagsInput.value.trim()) {
				addEditTag(editTagsInput.value);
				editTagsInput.value = '';
			}

			const payload = getSnippetPayload({
				userId: sessionUserId,
				orderNumber: snippets.find((snippet) => snippet.id === id)?.orderNumber ?? 0,
				text,
				description: editDescInput?.value.trim() || '',
				tags: [...editTags],
				category: editCategorySelect.value,
				pinned: snippets.find((snippet) => snippet.id === id)?.pinned ?? false
			});

			const { error } = await supabase
				.from('snippets')
				.update(payload)
				.eq('id', id)
				.eq('user_id', sessionUserId);

			if (error) {
				console.error('Update failed', error);
				showToast('Failed to update snippet', 'error');
				return;
			}

			const idx = snippets.findIndex((snippet) => snippet.id === id);
			if (idx !== -1) {
				snippets[idx] = {
					...snippets[idx],
					...normalizeSnippet({ id, ...payload })
				};
			}

			renderSnippets();
			closeEditModal();
			showToast('Snippet updated!', 'success');
		});
	}

	function wireVariablesModal() {
		variablesModalCloseBtn?.addEventListener('click', closeVariablesModal);
		variablesModalCancelBtn?.addEventListener('click', closeVariablesModal);
		variablesModal?.addEventListener('click', (e) => {
			if (e.target === variablesModal) closeVariablesModal();
		});

		if (!variablesForm) return;
		variablesForm.addEventListener('submit', async (e) => {
			e.preventDefault();
			if (!pendingCopyText || !pendingCopyButton) return;

			const values = {};
			const formData = new FormData(variablesForm);
			for (const [key, value] of formData.entries()) {
				values[key] = String(value).trim();
			}

			const missingValue = Object.values(values).some((value) => value === '');
			if (missingValue) {
				showToast('Completa todas las variables antes de copiar', 'error');
				return;
			}

			const resolvedText = resolveSnippetVariables(pendingCopyText, values);
			const button = pendingCopyButton;
			closeVariablesModal();
			await copyToClipboard(resolvedText, button);
		});
	}

	function wireModalCloseEvents() {
		document.getElementById('modal-close-btn')?.addEventListener('click', closeEditModal);
		document.getElementById('modal-cancel-btn')?.addEventListener('click', closeEditModal);
		editModal?.addEventListener('click', (e) => {
			if (e.target === editModal) closeEditModal();
		});
		document.addEventListener('keydown', (e) => {
			if (e.key !== 'Escape') return;
			if (variablesModal?.classList.contains('open')) {
				closeVariablesModal();
				return;
			}
			closeEditModal();
		});
	}

	function wireSearchAndFilters() {
		if (searchInput) {
			searchInput.addEventListener('input', (e) => {
				searchQuery = e.target.value;
				renderSnippets();
			});
		}

		filterButtons.forEach((btn) => {
			btn.addEventListener('click', () => {
				filterButtons.forEach((button) => button.classList.remove('active'));
				btn.classList.add('active');
				currentFilter = btn.getAttribute('data-category') || 'all';
				renderSnippets();
			});
		});
	}

	async function init() {
		initDomElements();
		updateThemeToggleState();
		wireAuthEvents();
		showAuthMode('login');

		supabase.auth.onAuthStateChange((_event, session) => {
			void syncAuthenticatedApp(session);
		});

		const { data, error } = await supabase.auth.getSession();
		if (error) {
			console.error('Session bootstrap failed', error);
			setAuthFeedback('No fue posible recuperar la sesión actual.', 'error');
			return;
		}

		await syncAuthenticatedApp(data.session);
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', () => void init(), { once: true });
	} else {
		void init();
	}
</script>

