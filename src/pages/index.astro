---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import SnippetForm from '../components/SnippetForm.astro';
import SearchFilter from '../components/SearchFilter.astro';
import SnippetCardTemplate from '../components/SnippetCardTemplate.astro';
import categories from '../data/categories.json';

// Filter out 'All' for form categories
const formCategories = categories.filter(cat => cat.id !== 'all');
---

<Layout>
	<main class="app-container">
		<Header />

		<div class="app-grid">
			<!-- Panel izquierdo: Snippet creator -->
			<aside class="editor-panel">
				<SnippetForm />
			</aside>

			<!-- Panel derecho: Search engine and History/List -->
			<section class="list-panel">
				<SearchFilter />

				<div class="snippets-grid" id="snippets-container">
					<!-- Will be dynamically filled with JavaScript -->
					<div class="loading-state">Loading snippets...</div>
				</div>
			</section>
		</div>

		<!-- Toast Container -->
		<div class="toast-container" id="toast-container"></div>
		
		<!-- Edit Modal -->
		<div class="modal-backdrop" id="edit-modal" aria-hidden="true">
			<div class="modal-box glass-card">
				<div class="modal-header">
					<h2>Edit Snippet</h2>
					<button class="modal-close-btn" id="modal-close-btn" title="Close">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
					</button>
				</div>
				<form id="edit-form" class="snippet-form">
					<input type="hidden" id="edit-snippet-id" />
					<div class="form-group">
						<label for="edit-snippet-text">Content</label>
						<textarea id="edit-snippet-text" rows="5" required></textarea>
					</div>
					<div class="form-group">
						<label for="edit-snippet-description">Description (Optional)</label>
						<input type="text" id="edit-snippet-description" placeholder="Add a short description..." autocomplete="off" />
					</div>
					<div class="form-group">
						<label>Tags (Optional)</label>
						<div class="tag-input-wrapper" id="edit-tag-input-wrapper">
							<div class="tag-chips-row" id="edit-tag-chips-row"></div>
							<input type="text" id="edit-snippet-tags-input" placeholder="Type a tag and press Enter..." autocomplete="off" />
						</div>
						<span class="tag-hint">Press <kbd>Enter</kbd> or <kbd>,</kbd> to add a tag</span>
					</div>
					<div class="form-group">
						<label for="edit-snippet-category">Category</label>
						<select id="edit-snippet-category">
							{categories.map(cat => (
								<option value={cat.value}>{cat.label}</option>
							))}
						</select>
					</div>
					<div class="modal-actions">
						<button type="button" class="btn btn-cancel" id="modal-cancel-btn">Cancel</button>
						<button type="submit" class="btn btn-save">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
							Save Changes
						</button>
					</div>
				</form>
			</div>
		</div>

		<!-- Variables Copy Modal -->
		<div class="modal-backdrop" id="variables-modal" aria-hidden="true">
			<div class="modal-box glass-card modal-box-compact">
				<div class="modal-header">
					<h2>Completar variables</h2>
					<button class="modal-close-btn" id="variables-modal-close-btn" title="Close">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
					</button>
				</div>
				<form id="variables-form" class="snippet-form">
					<p class="variables-modal-copy">Rellena los valores para generar el texto final antes de copiarlo.</p>
					<div class="variables-fields" id="variables-fields"></div>
					<div class="modal-actions">
						<button type="button" class="btn btn-cancel" id="variables-modal-cancel-btn">Cancelar</button>
						<button type="submit" class="btn btn-save">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
							Copiar texto
						</button>
					</div>
				</form>
			</div>
		</div>

		<!-- Snippet Card HTML Template -->
		<SnippetCardTemplate />
	</main>
</Layout>

<script type="module" define:vars={{ categories }}>
	// Categories data injected from Astro
	const CATEGORIES = categories;

	// Model representing a text snippet
	
	const DEFAULT_DATASET_FILE = '/snippets.json';
	let selectedDatasetKey = 'default';
	let selectedDatasetFriendlyName = 'snippets.json';
  let sortOrderAscending = true;

  // State
	let snippets= [];
	let currentFilter = 'all';
	let searchQuery = '';
	let pinnedIds = new Set(); // IDs of pinned snippets (persisted separately)
	let viewMode = 'grid'; // 'grid' | 'list'
	let currentTags= []; // tags being built in the form

	// DOM Elements
	let form= null;
	let textInput= null;
	let descriptionInput= null;
	let categorySelect= null;
	let tagsInput= null;
	let tagChipsRow= null;
	let searchInput= null;
	let snippetsContainer= null;
	let filterButtons= document.querySelectorAll('.filter-btn');
	let fileInput= null;
	let fileButton= null;
	let exportButton= null;
	let fileNameDisplay= null;
	let toastContainer= null;
	let template= null;

	function initDomElements() {
		form = document.getElementById('snippet-form');
		textInput = document.getElementById('snippet-text');
		descriptionInput = document.getElementById('snippet-description');
		categorySelect = document.getElementById('snippet-category');
		tagsInput = document.getElementById('snippet-tags-input');
		tagChipsRow = document.getElementById('tag-chips-row');
		searchInput = document.getElementById('search-input');
		snippetsContainer = document.getElementById('snippets-container');
		filterButtons = document.querySelectorAll('.filter-btn');
		fileInput = document.getElementById('snippet-file-input');
		fileButton = document.getElementById('snippet-file-button');
		exportButton = document.getElementById('export-snippets-button');
		fileNameDisplay = document.getElementById('snippet-file-name');
		toastContainer = document.getElementById('toast-container');
		template = document.getElementById('snippet-card-template');
	}

	initDomElements();

	// ---- Tag builder helpers ----
	function renderFormTags() {
		if (!tagChipsRow) return;
		tagChipsRow.innerHTML = '';
		currentTags.forEach((tag, i) => {
			const chip = document.createElement('span');
			chip.className = 'form-tag-chip';
			chip.textContent = tag;
			const removeBtn = document.createElement('button');
			removeBtn.type = 'button';
			removeBtn.className = 'form-tag-remove';
			removeBtn.title = 'Remove tag';
			removeBtn.textContent = '×';
			removeBtn.addEventListener('click', () => {
				currentTags.splice(i, 1);
				renderFormTags();
			});
			chip.appendChild(removeBtn);
			tagChipsRow.appendChild(chip);
		});
	}

	function addTag(raw) {
		const tag = raw.trim().toLowerCase().replace(/[^a-z0-9_-]/g, '');
		if (tag && !currentTags.includes(tag)) {
			currentTags.push(tag);
			renderFormTags();
		}
	}

	if (tagsInput) {
		tagsInput.addEventListener('keydown', (e) => {
			if (e.key === 'Enter' || e.key === ',') {
				e.preventDefault();
				addTag(tagsInput.value);
				tagsInput.value = '';
			} else if (e.key === 'Backspace' && tagsInput.value === '' && currentTags.length > 0) {
				currentTags.pop();
				renderFormTags();
			}
		});
		// Also support pasting comma-separated tags
		tagsInput.addEventListener('blur', () => {
			if (tagsInput.value.trim()) {
				addTag(tagsInput.value);
				tagsInput.value = '';
			}
		});
	}

	function getDatasetStorageKey(datasetKey) {
		return `clipbox_snippets_${datasetKey}`;
	}

	function getDatasetMetadataKey() {
		return 'clipbox_dataset_metadata';
	}

	function saveDatasetMetadata() {
		const metadata = {
			selectedDatasetFriendlyName,
			selectedDatasetKey
		};
		localStorage.setItem(getDatasetMetadataKey(), JSON.stringify(metadata));
	}

	function updateDatasetDisplayName(name) {
		selectedDatasetFriendlyName = name;
		if (fileNameDisplay) {
			fileNameDisplay.textContent = name;
		}
	}

	async function loadDefaultSnippets() {
		selectedDatasetKey = 'default';
		updateDatasetDisplayName(DEFAULT_DATASET_FILE.split('/').pop() || 'snippets.json');

		const storageKey = getDatasetStorageKey(selectedDatasetKey);
		const stored = localStorage.getItem(storageKey);
		if (stored) {
			try {
				snippets = JSON.parse(stored);
				saveDatasetMetadata();
				return;
			} catch (e) {
				console.warn('Invalid stored snippets for default dataset, reloading file version.');
			}
		}

		try {
			const response = await fetch(DEFAULT_DATASET_FILE);
			if (response.ok) {
				snippets = await response.json();
				saveDatasetMetadata();
				return;
			}
			console.warn('Unable to load default snippets from', DEFAULT_DATASET_FILE);
		} catch (e) {
			console.warn('Error fetching default snippet file:', e);
		}

		snippets = [];
		saveDatasetMetadata();
	}

	async function loadCustomSnippetsFromFile(file) {
		if (!file) return;
		const text = await file.text();
		try {
			const parsed = JSON.parse(text);
			if (!Array.isArray(parsed)) {
				throw new Error('JSON file must contain an array of snippets');
			}
			snippets = parsed;
			selectedDatasetKey = `custom_${file.name}`;
			updateDatasetDisplayName(file.name);
			saveSnippets();
			showToast(`Loaded ${file.name}`, 'success');
		} catch (e) {
			console.error('Error loading custom snippet file:', e);
			showToast('Invalid JSON file selected', 'error');
		}
	}

	function saveSnippets() {
		const storageKey = "clipbox_snippets";
		localStorage.setItem(storageKey, JSON.stringify(snippets));
		saveDatasetMetadata();
	}

	// ---- Pin persistence (independent of dataset) ----
	function loadPins() {
		try {
			const raw = localStorage.getItem('clipbox_pinned_ids');
			if (raw) pinnedIds = new Set(JSON.parse(raw));
		} catch { pinnedIds = new Set(); }
	}

	function savePins() {
		localStorage.setItem('clipbox_pinned_ids', JSON.stringify([...pinnedIds]));
	}

	function togglePin(id) {
		if (pinnedIds.has(id)) {
			pinnedIds.delete(id);
			showToast('Snippet unpinned', 'info');
		} else {
			pinnedIds.add(id);
			showToast('Snippet pinned!', 'success');
		}
		savePins();
		renderSnippets();
	}

	// ---- View mode (grid / list) ----
	const VIEW_ICON_GRID = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect></svg>`;
	const VIEW_ICON_LIST = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>`;

	function loadViewMode() {
		const saved = localStorage.getItem('clipbox_view_mode');
		viewMode = saved === 'list' ? 'list' : 'grid';
		applyViewMode();
	}

	function applyViewMode() {
		if (!snippetsContainer) return;
		snippetsContainer.classList.toggle('view-list', viewMode === 'list');

		const btn = document.getElementById('view-toggle-btn');
		if (btn) {
			const isListView = viewMode === 'list';
			btn.classList.toggle('is-list', isListView);
			btn.setAttribute('title', isListView ? 'Cambiar a vista de grilla' : 'Cambiar a vista de lista');
			btn.setAttribute('aria-label', isListView ? 'Cambiar a vista de grilla' : 'Cambiar a vista de lista');
			const icon = document.getElementById('view-toggle-icon');
			if (icon) icon.innerHTML = isListView ? VIEW_ICON_GRID : VIEW_ICON_LIST;
		}
	}

	function wireViewToggle() {
		const btn = document.getElementById('view-toggle-btn');
		if (!btn) return;
		btn.addEventListener('click', () => {
			viewMode = viewMode === 'grid' ? 'list' : 'grid';
			localStorage.setItem('clipbox_view_mode', viewMode);
			applyViewMode();
		});
	}

	async function loadSnippetsFromMetadata() {
		const metadata = localStorage.getItem(getDatasetMetadataKey());
		if (!metadata) {
			await loadDefaultSnippets();
			return;
		}

		try {
			const parsed = JSON.parse(metadata);
			if (parsed?.selectedDatasetKey === 'default') {
				await loadDefaultSnippets();
				return;
			}

			const storageKey = getDatasetStorageKey(parsed.selectedDatasetKey || 'default');
			const stored = localStorage.getItem(storageKey);
			if (stored) {
				snippets = JSON.parse(stored);
				selectedDatasetKey = parsed.selectedDatasetKey;
				updateDatasetDisplayName(parsed.selectedDatasetFriendlyName || parsed.selectedDatasetKey.replace(/^custom_/, 'Custom dataset'));
				return;
			}
		} catch (e) {
			console.warn('Invalid dataset metadata, loading default dataset.', e);
		}

		await loadDefaultSnippets();
	}

	function wireDatasetFileChooser() {
		if (!fileInput) return;

		if (fileButton) {
			fileButton.addEventListener('click', () => {
				if (fileInput) fileInput.click();
			});
		}

		fileInput.addEventListener('change', async () => {
			const file = fileInput.files?.[0];
			if (!file) return;
			await loadCustomSnippetsFromFile(file);
			renderSnippets();
		});
	}

	function wireExportButton() {
		if (!exportButton) return;
		exportButton.addEventListener('click', exportSnippetsToClipboard);
	}

	async function exportSnippetsToClipboard() {
		try {
			const storageKey = 'clipbox_snippets';
			const raw = localStorage.getItem(storageKey);
			if (!raw) {
				showToast('No snippets found in localStorage for default dataset', 'error');
				return;
			}

			const parsed = JSON.parse(raw);
			if (!Array.isArray(parsed)) {
				showToast('Default snippets data is invalid', 'error');
				return;
			}

			const exportText = JSON.stringify(parsed, null, 2);
			await navigator.clipboard.writeText(exportText);
			showToast(`Exported ${parsed.length} default snippets to clipboard!`, 'success');
		} catch (err) {
			console.error('Export failed', err);
			showToast('Failed to copy JSON to clipboard', 'error');
		}
	}

	async function init() {
		initDomElements();
		loadPins();
		loadViewMode();
		await loadSnippetsFromMetadata();
		wireDatasetFileChooser();
		wireExportButton();
		wireViewToggle();
		renderSnippets();
	}

	// Show toast notification
	function showToast(message, type) {
		const toast = document.createElement('div');
		toast.className = `toast toast-${type}`;
		
		// Icon based on type
		let icon = '';
		if (type === 'success') {
			icon = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>`;
		} else if (type === 'info') {
			icon = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>`;
		} else {
			icon = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>`;
		}

		toast.innerHTML = `
			<span class="toast-icon">${icon}</span>
			<span class="toast-message">${message}</span>
		`;

		toastContainer.appendChild(toast);

		// Animate entrance
		setTimeout(() => toast.classList.add('visible'), 10);

		// Remove after 2 seconds
		setTimeout(() => {
			toast.classList.remove('visible');
			const removeToast = () => toast.remove();
			toast.addEventListener('transitionend', removeToast, { once: true });
			// Fallback if transitionend does not fire (e.g. reduced motion)
			setTimeout(removeToast, 350);
		}, 2000);
	}

	// Copy to clipboard with animation feedback
	async function copyToClipboard(text, button) {
		try {
			await navigator.clipboard.writeText(text);
			
			// Visual feedback in button
			const originalHTML = button.innerHTML;
			button.classList.add('copied');
			button.innerHTML = `
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
			`;

			showToast('Text copied to clipboard!', 'success');

			setTimeout(() => {
				button.classList.remove('copied');
				button.innerHTML = originalHTML;
			}, 2000);
		} catch (err) {
			showToast('Error to copy text', 'error');
		}
	}

	const SNIPPET_VARIABLE_REGEX = /\{\{\s*([^{}]+?)\s*\}\}/g;

	function extractSnippetVariables(text) {
		const variables = [];
		const seen = new Set();
		for (const match of text.matchAll(SNIPPET_VARIABLE_REGEX)) {
			const name = match[1].trim();
			if (!name || seen.has(name)) continue;
			seen.add(name);
			variables.push(name);
		}
		return variables;
	}

	function resolveSnippetVariables(text, values) {
		return text.replace(SNIPPET_VARIABLE_REGEX, (_, rawName) => {
			const name = rawName.trim();
			return Object.prototype.hasOwnProperty.call(values, name) ? values[name] : '';
		});
	}

	const variablesModal = document.getElementById('variables-modal');
	const variablesForm = document.getElementById('variables-form');
	const variablesFields = document.getElementById('variables-fields');
	const variablesModalCloseBtn = document.getElementById('variables-modal-close-btn');
	const variablesModalCancelBtn = document.getElementById('variables-modal-cancel-btn');

	let pendingCopyButton = null;
	let pendingCopyText = '';

	function closeVariablesModal() {
		if (!variablesModal || !variablesFields) return;
		variablesModal.classList.remove('open');
		variablesModal.setAttribute('aria-hidden', 'true');
		variablesFields.innerHTML = '';
		pendingCopyButton = null;
		pendingCopyText = '';
	}

	function openVariablesModal(text, button) {
		if (!variablesModal || !variablesFields) {
			copyToClipboard(text, button);
			return;
		}

		const variables = extractSnippetVariables(text);
		if (variables.length === 0) {
			copyToClipboard(text, button);
			return;
		}

		pendingCopyButton = button;
		pendingCopyText = text;
		variablesFields.innerHTML = '';

		variables.forEach((name) => {
			const field = document.createElement('div');
			field.className = 'form-group variables-field';

			const label = document.createElement('label');
			label.className = 'variables-label';
			const inputId = `variable-input-${name.toLowerCase().replace(/[^a-z0-9_-]+/g, '-')}`;
			label.setAttribute('for', inputId);
			label.textContent = name;

			const input = document.createElement('input');
			input.type = 'text';
			input.id = inputId;
			input.name = name;
			input.className = 'variables-input';
			input.placeholder = `Valor para ${name}`;
			input.autocomplete = 'off';
			input.required = true;

			field.appendChild(label);
			field.appendChild(input);
			variablesFields.appendChild(field);
		});

		variablesModal.classList.add('open');
		variablesModal.setAttribute('aria-hidden', 'false');
		setTimeout(() => variablesFields.querySelector('input')?.focus(), 50);
	}

	async function handleSnippetCopy(text, button) {
		const variables = extractSnippetVariables(text);
		if (variables.length === 0) {
			await copyToClipboard(text, button);
			return;
		}
		openVariablesModal(text, button);
	}

	// Delete a snippet
	function deleteSnippet(id) {
		snippets = snippets.filter(s => s.id !== id);
		saveSnippets();
		renderSnippets();
		showToast('Snippet deleted', 'info');
	}

	// ---- Edit Modal ----
	const editModal = document.getElementById('edit-modal');
	const editForm = document.getElementById('edit-form');
	const editIdInput = document.getElementById('edit-snippet-id');
	const editTextInput = document.getElementById('edit-snippet-text');
	const editDescInput = document.getElementById('edit-snippet-description');
	const editCategorySelect = document.getElementById('edit-snippet-category');
	const editTagsInput = document.getElementById('edit-snippet-tags-input');
	const editTagChipsRow = document.getElementById('edit-tag-chips-row');

	let editTags= [];

	function renderEditTags() {
		if (!editTagChipsRow) return;
		editTagChipsRow.innerHTML = '';
		editTags.forEach((tag, i) => {
			const chip = document.createElement('span');
			chip.className = 'form-tag-chip';
			chip.textContent = tag;
			const removeBtn = document.createElement('button');
			removeBtn.type = 'button';
			removeBtn.className = 'form-tag-remove';
			removeBtn.title = 'Remove tag';
			removeBtn.textContent = '×';
			removeBtn.addEventListener('click', () => {
				editTags.splice(i, 1);
				renderEditTags();
			});
			chip.appendChild(removeBtn);
			editTagChipsRow.appendChild(chip);
		});
	}

	function addEditTag(raw) {
		const tag = raw.trim().toLowerCase().replace(/[^a-z0-9_-]/g, '');
		if (tag && !editTags.includes(tag)) {
			editTags.push(tag);
			renderEditTags();
		}
	}

	function openEditModal(id) {
		const snippet = snippets.find(s => s.id === id);
		if (!snippet) return;
		editIdInput.value = snippet.id;
		editTextInput.value = snippet.text;
		editDescInput.value = snippet.description || '';
		editCategorySelect.value = snippet.category;
		editTags = [...(snippet.tags || [])];
		renderEditTags();
		editModal.setAttribute('aria-hidden', 'false');
		editModal.classList.add('open');
		setTimeout(() => editTextInput.focus(), 50);
	}

	function closeEditModal() {
		editModal.classList.remove('open');
		editModal.setAttribute('aria-hidden', 'true');
		editTags = [];
		if (editTagsInput) editTagsInput.value = '';
	}

	if (editTagsInput) {
		editTagsInput.addEventListener('keydown', (e) => {
			if (e.key === 'Enter' || e.key === ',') {
				e.preventDefault();
				addEditTag(editTagsInput.value);
				editTagsInput.value = '';
			} else if (e.key === 'Backspace' && editTagsInput.value === '' && editTags.length > 0) {
				editTags.pop();
				renderEditTags();
			}
		});
		editTagsInput.addEventListener('blur', () => {
			if (editTagsInput.value.trim()) {
				addEditTag(editTagsInput.value);
				editTagsInput.value = '';
			}
		});
	}

	// Close buttons
	document.getElementById('modal-close-btn')?.addEventListener('click', closeEditModal);
	document.getElementById('modal-cancel-btn')?.addEventListener('click', closeEditModal);
	editModal?.addEventListener('click', (e) => { if (e.target === editModal) closeEditModal(); });
	variablesModalCloseBtn?.addEventListener('click', closeVariablesModal);
	variablesModalCancelBtn?.addEventListener('click', closeVariablesModal);
	variablesModal?.addEventListener('click', (e) => { if (e.target === variablesModal) closeVariablesModal(); });
	document.addEventListener('keydown', (e) => {
		if (e.key !== 'Escape') return;
		if (variablesModal?.classList.contains('open')) {
			closeVariablesModal();
			return;
		}
		closeEditModal();
	});

	if (variablesForm) {
		variablesForm.addEventListener('submit', async (e) => {
			e.preventDefault();
			if (!pendingCopyText || !pendingCopyButton) return;

			const values = {};
			const formData = new FormData(variablesForm);
			for (const [key, value] of formData.entries()) {
				values[key] = String(value).trim();
			}

			const missingValue = Object.values(values).some(value => value === '');
			if (missingValue) {
				showToast('Completa todas las variables antes de copiar', 'error');
				return;
			}

			const resolvedText = resolveSnippetVariables(pendingCopyText, values);
			const button = pendingCopyButton;
			closeVariablesModal();
			await copyToClipboard(resolvedText, button);
		});
	}

	if (editForm) {
		editForm.addEventListener('submit', (e) => {
			e.preventDefault();
			const id = editIdInput.value;
			const text = editTextInput.value.trim();
			if (!text) return;
			// Flush any unconfirmed tag
			if (editTagsInput && editTagsInput.value.trim()) {
				addEditTag(editTagsInput.value);
				editTagsInput.value = '';
			}
			const idx = snippets.findIndex(s => s.id === id);
			if (idx !== -1) {
				snippets[idx] = {
					...snippets[idx],
					text,
					description: editDescInput.value.trim() || undefined,
					tags: editTags.length > 0 ? [...editTags] : undefined,
					category: editCategorySelect.value
				};
				saveSnippets();
				renderSnippets();
				closeEditModal();
				showToast('Snippet updated!', 'success');
			}
		});
	}

  function updateSortButtonUI() {
    const sortBtn = document.getElementById('sort-order-btn');
    const text = document.getElementById('sort-order-text');
    if (!sortBtn || !text) return;

    sortBtn.classList.toggle('sort-asc', sortOrderAscending);
    sortBtn.classList.toggle('sort-desc', !sortOrderAscending);
    sortBtn.setAttribute('aria-pressed', String(sortOrderAscending));
    text.textContent = sortOrderAscending ? 'Ascendente' : 'Descendente';
  }

  const sortBtn = document.getElementById('sort-order-btn');
  if (sortBtn) {
      updateSortButtonUI();
      sortBtn.addEventListener('click', () => {
          sortOrderAscending = !sortOrderAscending;
          updateSortButtonUI();
          renderSnippets();
      });
  }

  // Get SVG icon for category
	function getCategoryBadge(category) {
		const categoryData = CATEGORIES.find(cat => cat.value === category);
		if (categoryData) {
			return { label: `${categoryData.emoji} ${categoryData.label}`, class: categoryData.badge };
		}
		return { label: '👺 All', class: 'badge-all' };
	}

	function getSnippetUrl(text) {
		const trimmed = text.trim();
		if (!trimmed) return null;
		if (/^https?:\/\//i.test(trimmed)) return trimmed;
		try {
			const url = new URL(trimmed.startsWith('//') ? `https:${trimmed}` : `https://${trimmed}`);
			return url.href;
		} catch {
			return null;
		}
	}

	function isSnippetLink(snippet) {
		return snippet.category === 'Link' && getSnippetUrl(snippet.text) !== null;
	}

	// Render the list of snippets
	function renderSnippets() {
		// Filter by search query and category selector
		const filtered = snippets.filter(s => {
			const matchesCategory = currentFilter === 'all' || s.category === currentFilter;
			const matchesSearch = s.text.toLowerCase().includes(searchQuery.toLowerCase()) || 
			                      (s.description && s.description.toLowerCase().includes(searchQuery.toLowerCase())) ||
			                      (s.tags && s.tags.some(t => t.includes(searchQuery.toLowerCase()))) ||
			                      s.category.toLowerCase().includes(searchQuery.toLowerCase());
			return matchesCategory && matchesSearch;
		});
    
    // Sort by id in current order
    filtered.sort((a, b) => sortOrderAscending ? a.id - b.id : b.id - a.id);

		if (filtered.length === 0) {
			snippetsContainer.innerHTML = `
				<div class="empty-state">
					<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="8" y1="12" x2="16" y2="12"></line></svg>
					<p>No se encontraron snippets que coincidan con la búsqueda.</p>
				</div>
			`;
			return;
		}

		snippetsContainer.innerHTML = '';

		// Split into pinned and rest
		const pinned = filtered.filter(s => pinnedIds.has(s.id));
		const rest    = filtered.filter(s => !pinnedIds.has(s.id));

		// Render pinned snippets as independent cards at the start of the grid
		if (pinned.length > 0) {
			pinned.forEach(snippet => {
				snippetsContainer.appendChild(buildCard(snippet));
			});
		}

		// Render the rest
		rest.forEach(snippet => {
			snippetsContainer.appendChild(buildCard(snippet));
		});
	}

	function buildCard(snippet) {
		const badge = getCategoryBadge(snippet.category);
		const isPinned = pinnedIds.has(snippet.id);
		
		// Clone the card from the template element
		const clone = document.importNode(template.content, true);
		const card = clone.querySelector('.snippet-card');

		if (isPinned && card) card.classList.add('is-pinned');
		
		// Set badge info
		const badgeEl = clone.querySelector('.category-badge');
		if (badgeEl) {
			badgeEl.textContent = badge.label;
			badgeEl.className = `category-badge ${badge.class}`;
		}

		// Set description
		const descEl = clone.querySelector('.snippet-description');
		if (descEl) {
			if (snippet.description) {
				descEl.textContent = snippet.description;
				descEl.style.display = 'block';
			} else {
				descEl.style.display = 'none';
			}
		}

		// Set text content
		const codeEl = clone.querySelector('code');
		if (codeEl) {
			codeEl.textContent = snippet.text;
		}

		// Set tags
		const tagsEl = clone.querySelector('.snippet-tags');
		if (tagsEl && snippet.tags && snippet.tags.length > 0) {
			snippet.tags.forEach(tag => {
				const chip = document.createElement('span');
				chip.className = 'tag-chip';
				chip.textContent = tag;
				tagsEl.appendChild(chip);
			});
		}

		// Pin button
		const pinBtn = clone.querySelector('.pin-btn');
		if (pinBtn) {
			if (isPinned) pinBtn.classList.add('pinned');
			pinBtn.title = isPinned ? 'Unpin snippet' : 'Pin snippet';
			pinBtn.addEventListener('click', () => togglePin(snippet.id));
		}

		// Add event listener to copy button
		const copyBtn = clone.querySelector('.copy-btn');
		if (copyBtn) {
			copyBtn.addEventListener('click', () => handleSnippetCopy(snippet.text, copyBtn));
		}

		// Show open-link button only for link snippets
		const openLinkBtn = clone.querySelector('.open-link-btn');
		if (openLinkBtn) {
			const url = getSnippetUrl(snippet.text);
			if (isSnippetLink(snippet) && url) {
				openLinkBtn.href = url;
				openLinkBtn.hidden = false;
			} else {
				openLinkBtn.hidden = true;
			}
		}

		// Add event listener to edit button
		const editBtn = clone.querySelector('.edit-btn');
		if (editBtn) {
			editBtn.addEventListener('click', () => openEditModal(snippet.id));
		}

		// Add event listener to delete button
		const deleteBtn = clone.querySelector('.delete-btn');
		if (deleteBtn) {
			deleteBtn.addEventListener('click', () => deleteSnippet(snippet.id));
		}

		return clone;
	}

  // Get next numeric ID
  function getNextSnippetId() {
      if (snippets.length === 0) return 1;
      const maxId = Math.max(...snippets.map(s => typeof s.id === 'number' ? s.id : 0));
      return maxId + 1;
  }

  // Handle form submission to add snippet
	if (form) {
		form.addEventListener('submit', (e) => {
			e.preventDefault();
			const text = textInput.value.trim();
			const description = descriptionInput ? descriptionInput.value.trim() : '';
			// Flush any unconfirmed tag still in the input
			if (tagsInput && tagsInput.value.trim()) {
				addTag(tagsInput.value);
				tagsInput.value = '';
			}
			const tags = [...currentTags];
			const category = categorySelect.value;

			if (!text) return;

			const newSnippet= {
				id: getNextSnippetId(),
				text,
				description: description || undefined,
				tags: tags.length > 0 ? tags : undefined,
				category
			};

			snippets.unshift(newSnippet);
			saveSnippets();
			renderSnippets();
			
			// Reset form
			textInput.value = '';
			if (descriptionInput) descriptionInput.value = '';
			currentTags = [];
			renderFormTags();
			showToast('Snippet created successfully!');
		});
	}

	// Handle search input
	if (searchInput) {
		searchInput.addEventListener('input', (e) => {
			searchQuery = (e.target).value;
			renderSnippets();
		});
	}

	// Handle filter buttons
	filterButtons.forEach(btn => {
		btn.addEventListener('click', () => {
			filterButtons.forEach(b => b.classList.remove('active'));
			btn.classList.add('active');
			currentFilter = btn.getAttribute('data-category') || 'all';
			renderSnippets();
		});
	});

	init();
</script>

