		flex-shrink: 0;
	}

	.theme-toggle:hover {
		background: var(--bg-hover);
		border-color: var(--primary);
		color: var(--primary);
		transform: rotate(12deg);
	}

	html.runtime-tauri .theme-toggle:hover {
		transform: rotate(8deg);
	}

	html.runtime-tauri[data-desktop-platform='macos'] .theme-toggle {
		background: rgba(255, 255, 255, 0.03);
		border-color: rgba(255, 255, 255, 0.06);
	}

	html.light.runtime-tauri[data-desktop-platform='macos'] .theme-toggle {
		background: rgba(99, 102, 241, 0.04);
		border-color: rgba(99, 102, 241, 0.08);
	}

	html.runtime-tauri[data-desktop-platform='macos'] .theme-toggle:hover {
		transform: rotate(0deg);
