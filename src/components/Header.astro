<header class="app-header">
	<div class="logo-area">
		<div class="logo-icon">
			<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
		</div>
		<div>
			<h1>ClipBox</h1>
			<p class="tagline">Save and copy your favorite texts with a single click.</p>
		</div>
	</div>

	<div class="header-actions">
		<button id="install-button" class="install-button" type="button" hidden>
			<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
			<span id="install-button-label">Instalar app</span>
		</button>

		<button id="theme-toggle" class="theme-toggle" type="button" title="Toggle theme" aria-label="Toggle light/dark theme">
			<!-- Moon icon (shown in dark mode) -->
			<svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
			<!-- Sun icon (shown in light mode) -->
			<svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
		</button>
	</div>
</header>

<script>
	const btn = document.getElementById('theme-toggle');
	const html = document.documentElement;
	const installBtn = document.getElementById('install-button') as HTMLButtonElement | null;
	const installBtnLabel = document.getElementById('install-button-label');
	let deferredInstallPrompt: Event | null = null;

	function applyTheme(theme: string) {
		if (theme === 'light') {
			html.classList.add('light');
		} else {
			html.classList.remove('light');
		}
		localStorage.setItem('clipbox_theme', theme);
	}

	btn?.addEventListener('click', () => {
		const isLight = html.classList.contains('light');
		applyTheme(isLight ? 'dark' : 'light');
	});

	function isStandaloneMode() {
		return window.matchMedia('(display-mode: standalone)').matches || (window.navigator as Navigator & { standalone?: boolean }).standalone === true;
	}

	function updateInstallButtonState() {
		if (!installBtn || !installBtnLabel) return;
		if (isStandaloneMode()) {
			installBtn.hidden = false;
			installBtn.disabled = true;
			installBtnLabel.textContent = 'App instalada';
			return;
		}

		if (deferredInstallPrompt) {
			installBtn.hidden = false;
			installBtn.disabled = false;
			installBtnLabel.textContent = 'Instalar app';
			return;
		}

		installBtn.hidden = true;
	}

	window.addEventListener('beforeinstallprompt', (event) => {
		event.preventDefault();
		deferredInstallPrompt = event;
		updateInstallButtonState();
	});

	window.addEventListener('appinstalled', () => {
		deferredInstallPrompt = null;
		updateInstallButtonState();
	});

	installBtn?.addEventListener('click', async () => {
		if (!deferredInstallPrompt || !installBtn) return;
		const installEvent = deferredInstallPrompt as Event & {
			prompt: () => Promise<void>;
			userChoice?: Promise<{ outcome: 'accepted' | 'dismissed' }>;
		};

		await installEvent.prompt();
		await installEvent.userChoice;
		deferredInstallPrompt = null;
		updateInstallButtonState();
	});

	updateInstallButtonState();
</script>

<style>
	.app-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		border-bottom: 1px solid var(--border-color, rgba(255, 255, 255, 0.08));
		padding-bottom: 1.5rem;
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.logo-area {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.logo-icon {
		background: linear-gradient(135deg, var(--primary, #6366f1), #a855f7);
		color: #ffffff;
		padding: 0.75rem;
		border-radius: 12px;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 4px 20px var(--primary-glow, rgba(99, 102, 241, 0.3));
	}

	.app-header h1 {
		font-family: var(--font-title, sans-serif);
		font-size: 1.75rem;
		font-weight: 800;
		margin: 0;
		background: linear-gradient(135deg, #ffffff 60%, #a5b4fc 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		letter-spacing: -0.02em;
	}

	html.light .app-header h1 {
		background: linear-gradient(135deg, #1e1b4b 60%, #6366f1 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.tagline {
		color: var(--text-muted, #9ca3af);
		font-size: 0.875rem;
		margin: 0.25rem 0 0 0;
	}

	.install-button,
	.theme-toggle {
		background: var(--bg-card, rgba(22, 24, 37, 0.7));
		border: 1px solid var(--border-color);
		color: var(--text-muted);
		cursor: pointer;
		border-radius: 10px;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: background 0.2s, border-color 0.2s, color 0.2s, transform 0.2s;
		flex-shrink: 0;
	}

	.install-button {
		gap: 0.5rem;
		padding: 0.65rem 0.9rem;
		font-family: inherit;
		font-size: 0.875rem;
		font-weight: 600;
	}

	.install-button:hover:not(:disabled) {
		background: var(--bg-hover);
		border-color: var(--primary);
		color: var(--primary);
	}

	.install-button:disabled {
		cursor: default;
		opacity: 0.85;
		color: var(--text-primary);
	}

	/* Theme toggle button */
	.theme-toggle {
		padding: 0.55rem;
	}

	.theme-toggle:hover {
		background: var(--bg-hover);
		border-color: var(--primary);
		color: var(--primary);
		transform: rotate(12deg);
	}

	/* Show moon in dark, sun in light */
	.icon-sun  { display: none; }
	.icon-moon { display: block; }

	html.light .icon-sun  { display: block; }
	html.light .icon-moon { display: none; }

	@media (max-width: 720px) {
		.app-header {
			flex-direction: column;
			align-items: flex-start;
			gap: 1rem;
		}

		.header-actions {
			width: 100%;
		}

		.install-button {
			flex: 1;
		}
	}
</style>
