<style is:global>
	/* Snippet Card and styling details that need to be globally visible when cloned */
	.snippet-card {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding: 1.25rem;
		min-height: 50px;
		background: rgba(20, 22, 34, 0.4);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
		transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.2s cubic-bezier(0.4, 0, 0.2, 1), border-color 0.2s;
	}

	.snippet-card:hover {
		transform: translateY(-2px);
		box-shadow: 0 12px 24px rgba(0, 0, 0, 0.3);
		border-color: rgba(99, 102, 241, 0.2) !important;
	}

	.card-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 0.875rem;
	}

	/* Category Badges */
	.category-badge {
		font-size: 0.75rem;
		font-weight: 600;
		padding: 0.25rem 0.625rem;
		border-radius: 6px;
	}

	.badge-all {
		background: rgba(99, 102, 241, 0.1);
		color: #a5b4fc;
		border: 1px solid rgba(99, 102, 241, 0.2);
	}

	.badge-code {
		background: rgba(168, 85, 247, 0.1);
		color: #d8b4fe;
		border: 1px solid rgba(168, 85, 247, 0.2);
	}

	.badge-link {
		background: rgba(14, 165, 233, 0.1);
		color: #7dd3fc;
		border: 1px solid rgba(14, 165, 233, 0.2);
	}

	.badge-note {
		background: rgba(245, 158, 11, 0.1);
		color: #fde047;
		border: 1px solid rgba(245, 158, 11, 0.2);
	}

  .badge-core {
    background: rgba(16, 185, 129, 0.1);
    color: #10b981;
    border: 1px solid rgba(16, 185, 129, 0.2);
  }

  .badge-devs {
    background: rgba(236, 72, 153, 0.1);
    color: #ec4899;
    border: 1px solid rgba(236, 72, 153, 0.2);
  }

  .badge-qes {
    background: rgba(139, 92, 246, 0.1);
    color: #8b5cf6;
    border: 1px solid rgba(139, 92, 246, 0.2);
  }

  .badge-aks {
    background: rgba(34, 197, 94, 0.1);
    color: #22c55e;
    border: 1px solid rgba(34, 197, 94, 0.2);
  }

	/* Card Header Actions Wrapper */
	.card-header-actions {
		display: flex;
		align-items: center;
		gap: 0.35rem;
	}

	/* Copy Button */
	.copy-btn {
		background: transparent;
		border: none;
		color: rgba(255, 255, 255, 0.2);
		cursor: pointer;
		padding: 0.25rem;
		border-radius: 6px;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: all 0.2s;
	}

	.copy-btn:hover {
		color: var(--accent-success, #10b981);
		background: rgba(16, 185, 129, 0.1);
	}

	.copy-btn.copied {
		color: var(--accent-success, #10b981) !important;
		background: rgba(16, 185, 129, 0.2) !important;
	}

	/* Delete Button */
	.delete-btn {
		background: transparent;
		border: none;
		color: rgba(255, 255, 255, 0.2);
		cursor: pointer;
		padding: 0.25rem;
		border-radius: 6px;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: all 0.2s;
	}

	.delete-btn:hover {
		color: var(--accent-error, #ef4444);
		background: rgba(239, 68, 68, 0.1);
	}

	/* Edit Button */
	.edit-btn {
		background: transparent;
		border: none;
		color: rgba(255, 255, 255, 0.2);
		cursor: pointer;
		padding: 0.25rem;
		border-radius: 6px;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: all 0.2s;
	}

	.edit-btn:hover {
		color: var(--accent-info, #0ea5e9);
		background: rgba(14, 165, 233, 0.1);
	}

	/* Open Link Button */
	.open-link-btn {
		background: transparent;
		border: none;
		color: rgba(255, 255, 255, 0.2);
		cursor: pointer;
		padding: 0.25rem;
		border-radius: 6px;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: all 0.2s;
		text-decoration: none;
		line-height: 0;
	}

	.open-link-btn:hover {
		color: #7dd3fc;
		background: rgba(14, 165, 233, 0.1);
	}

	.open-link-btn[hidden] {
		display: none;
	}

	/* Pin Button */
	.pin-btn {
		background: transparent;
		border: none;
		color: rgba(255, 255, 255, 0.2);
		cursor: pointer;
		padding: 0.25rem;
		border-radius: 6px;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: all 0.2s;
	}

	.pin-btn:hover {
		color: #fbbf24;
		background: rgba(251, 191, 36, 0.1);
	}

	.pin-btn.pinned {
		color: #fbbf24;
	}

	.pin-btn.pinned svg {
		fill: #fbbf24;
		stroke: #fbbf24;
	}

	/* Pinned card highlight */
	.snippet-card.is-pinned {
		border-color: rgba(251, 191, 36, 0.3) !important;
		background: rgba(251, 191, 36, 0.04) !important;
	}

	.snippet-card.is-pinned:hover {
		border-color: rgba(251, 191, 36, 0.5) !important;
	}

	.card-body {
		flex-grow: 1;
		margin-bottom: 0.5rem;
		overflow: hidden;
	}

	.snippet-description {
		margin: 0 0 0.5rem 0;
		font-size: 0.8rem;
		color: var(--text-muted, #9ca3af);
		font-weight: 500;
		line-height: 1.4;
	}

	.snippet-content {
		margin: 0;
		padding: 0;
		white-space: pre-wrap;
		word-break: break-all;
		font-family: 'Fira Code', 'Courier New', Courier, monospace;
		font-size: 0.9rem;
		line-height: 1.5;
		color: #e4e4e7;
		max-height: 120px;
		overflow-y: auto;
	}

	/* Tags row */
	.snippet-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 0.625rem;
		padding-top: 0.5rem;
		border-top: 1px solid rgba(255, 255, 255, 0.05);
	}

	.snippet-tags:empty {
		display: none;
	}

	.tag-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.2rem;
		background: rgba(99, 102, 241, 0.06);
		border: 1px solid rgba(99, 102, 241, 0.30);
		color: #8b9cf4;
		font-size: 0.62rem;
		font-weight: 700;
		padding: 0.15rem 0.5rem;
		border-radius: 20px;
		letter-spacing: 0.04em;
		text-transform: lowercase;
		transition: background 0.15s, border-color 0.15s;
	}

	.tag-chip::before {
		content: '#';
		opacity: 0.55;
		font-size: 0.58rem;
	}
</style>
