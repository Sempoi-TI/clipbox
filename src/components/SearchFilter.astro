---
import categories from '../data/categories.json';
---

<div class="search-filter-container">
	<div class="search-filter-inner">
		<div class="source-picker-wrapper">
			<label for="snippet-file-input">Choose dataset</label>
			<div class="source-file-picker">
				<button type="button" id="snippet-file-button">Browse JSON file</button>
				<button type="button" id="export-snippets-button" class="export-btn">Export JSON</button>


				<div class="sort-controls">
					<button id="sort-order-btn" title="Toggle sort order" class="sort-btn">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
						<span id="sort-order-text"></span>
					</button>
				</div>
				<input type="file" id="snippet-file-input" accept=".json,application/json" hidden />
			</div>
		</div>

		<div class="search-bar-wrapper">
	<div class="search-icon">
		<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
	</div>
	<input 
		type="text" 
		id="search-input" 
		placeholder="Search by content or category..." 
		autocomplete="off"
	/>
</div>

<div class="filter-tags">
	{categories.map(cat => (
		<button 
			class={`filter-btn ${cat.id === 'all' ? 'active' : ''}`} 
			data-category={cat.id === 'all' ? 'all' : cat.value}
		>
			{cat.emoji} {cat.label}
		</button>
	))}
</div>
</div>
</div>

<style>
  .sort-controls {
    display: flex;
    gap: 0.5rem;
    justify-content: flex-end;
    margin-bottom: 1rem;
}

.sort-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--text-muted);
    padding: 0.5rem 0.875rem;
    border-radius: 10px;
    cursor: pointer;
    font-family: inherit;
    font-weight: 600;
    font-size: 0.85rem;
    transition: all 0.2s;
}

.sort-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    border-color: var(--primary);
}
	.search-bar-wrapper {
		position: relative;
		width: 100%;
		max-width: 92%;
    margin-bottom: 1rem;
	}

	.search-bar-wrapper input {
		width: 100%;
		background: var(--bg-card, rgba(22, 24, 37, 0.7));
		border: 1px solid var(--border-color, rgba(255, 255, 255, 0.08));
		border-radius: 12px;
		color: var(--text-primary, #f3f4f6);
		padding: 0.875rem 1rem 0.875rem 2.75rem;
		font-size: 1rem;
		outline: none;
		transition: all 0.2s;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
	}

	.search-bar-wrapper input:focus {
		border-color: var(--primary, #6366f1);
		box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15), 0 4px 20px rgba(0, 0, 0, 0.1);
		background: rgba(22, 24, 37, 0.9);
	}

	.search-icon {
		position: absolute;
		left: 1rem;
		top: 50%;
		transform: translateY(-50%);
		color: var(--text-muted, #9ca3af);
		pointer-events: none;
		display: flex;
		align-items: center;
	}

	.search-filter-container {
		width: 100%;
		max-width: 100%;
		box-sizing: border-box;
	}

	.search-filter-inner {
		width: 100%;
		max-width: 100%;
		box-sizing: border-box;
		margin: 0;
	}

	.source-picker-wrapper {
		display: grid;
		width: 100%;
		max-width: 100%;
		gap: 0.5rem;
		margin-bottom: 1rem;
	}

	.source-picker-wrapper label {
		display: block;
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--text-muted, #9ca3af);
	}

	.source-picker-wrapper .source-file-picker {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
		max-width: 100%;
	}

	.source-picker-wrapper button {
		flex-shrink: 0;
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid var(--border-color, rgba(255, 255, 255, 0.08));
		border-radius: 12px;
		color: var(--text-primary, #f3f4f6);
		padding: 0.85rem 1rem;
		font-size: 0.95rem;
		cursor: pointer;
		transition: all 0.2s;
	}

	.source-picker-wrapper button:hover {
		background: rgba(255, 255, 255, 0.08);
	}

	.source-picker-wrapper .source-file-name {
		color: var(--text-muted, #9ca3af);
		font-size: 0.9rem;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		max-width: 240px;
	}

	.filter-tags {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.filter-btn {
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid var(--border-color, rgba(255, 255, 255, 0.08));
		color: var(--text-muted, #9ca3af);
		padding: 0.5rem 1rem;
		border-radius: 15px;
		font-size: 0.65rem;
		font-weight: 500;
		cursor: pointer;
		transition: all 0.2s;
	}

	.filter-btn:hover {
		background: rgba(255, 255, 255, 0.06);
		color: #ffffff;
		border-color: rgba(255, 255, 255, 0.15);
	}

	.filter-btn.active {
		background: rgba(99, 102, 241, 0.12);
		border-color: rgba(99, 102, 241, 0.4);
		color: #a5b4fc;
	}
</style>
