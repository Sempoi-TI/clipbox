---
import categories from '../data/categories.json';
---

<div class="search-filter-container">
	<div class="search-filter-inner">
		<div class="source-picker-wrapper">
			<label for="export-snippets-button">Biblioteca</label>
			<div class="source-file-picker">
				<span id="snippet-source-name" class="source-file-name source-file-name-connected">
					<span class="source-file-name-icon" aria-hidden="true">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
							<ellipse cx="12" cy="5" rx="7" ry="3"></ellipse>
							<path d="M5 5v6c0 1.66 3.13 3 7 3s7-1.34 7-3V5"></path>
							<path d="M5 11v6c0 1.66 3.13 3 7 3s7-1.34 7-3v-6"></path>
						</svg>
					</span>
					<span class="source-file-name-copy">
						<span class="source-file-name-label">Estado</span>
						<span class="source-file-name-value">Cuenta personal</span>
					</span>
				</span>
				<button type="button" id="export-snippets-button" class="export-btn">Exportar JSON</button>
				<div class="sort-controls">
					<button type="button" id="sort-order-btn" title="Cambiar orden de snippets" class="sort-btn sort-desc" aria-pressed="false">
						<span class="sort-btn-icon" aria-hidden="true">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
								<path d="M12 5v14"></path>
								<path d="m7 10 5-5 5 5"></path>
								<path d="m7 14 5 5 5-5"></path>
							</svg>
						</span>
						<span class="sort-btn-copy">
							<span class="sort-btn-label">Orden</span>
							<span id="sort-order-text" class="sort-btn-value">Descendente</span>
						</span>
					</button>

					<!-- View toggle -->
					<button type="button" id="view-toggle-btn" class="view-toggle-btn" title="Cambiar a vista de lista" aria-label="Cambiar a vista de lista">
						<span id="view-toggle-icon" class="view-toggle-icon" aria-hidden="true">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
						</span>
					</button>
				</div>
			</div>
		</div>

		<div class="search-bar-wrapper">
	<div class="search-icon">
		<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
	</div>
	<input 
		type="text" 
		id="search-input" 
		placeholder="Buscar por contenido, categoría o etiqueta" 
		autocomplete="off"
	/>
</div>

<div class="filter-tags">
	{categories.map(cat => (
		<button 
			class={`filter-btn ${cat.id === 'all' ? 'active' : ''}`} 
			data-category={cat.id === 'all' ? 'all' : cat.value}
		>
			{cat.emoji} {cat.label}
		</button>
	))}
</div>

<!-- Tag filter row — populated dynamically by JS -->
<div class="tag-filter-row" id="tag-filter-row" hidden>
	<span class="tag-filter-label"># Snippets</span>
	<div class="tag-filter-chips" id="tag-filter-chips"></div>
</div>
</div>
</div>

<style>
  .search-filter-container {
    --search-filter-button-height: 2.5rem;
  }

  .sort-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
  }

  /* View toggle button */
  .view-toggle-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--search-filter-button-height);
    height: var(--search-filter-button-height);
    background: var(--bg-hover);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.2s;
    flex-shrink: 0;
  }

  .view-toggle-btn:hover {
    background: var(--bg-card);
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-toggle-btn.is-list {
    background: rgba(99, 102, 241, 0.1);
    border-color: rgba(99, 102, 241, 0.35);
    color: #a5b4fc;
  }

  .view-toggle-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    line-height: 0;
  }

  .view-toggle-icon svg {
    display: block;
    width: 16px;
    height: 16px;
    stroke: currentColor;
    flex-shrink: 0;
  }

  .sort-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    background: rgba(99, 102, 241, 0.08);
    border: 1px solid rgba(99, 102, 241, 0.22);
    color: var(--text-secondary);
    min-height: var(--search-filter-button-height);
    padding: 0.4rem 0.9rem 0.4rem 0.7rem;
    border-radius: 12px;
    cursor: pointer;
    font-family: inherit;
    transition: background 0.2s, border-color 0.2s, box-shadow 0.2s, transform 0.15s;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
  }

  .sort-btn:hover {
    background: rgba(99, 102, 241, 0.14);
    border-color: rgba(99, 102, 241, 0.42);
    color: var(--text-primary);
    transform: translateY(-1px);
    box-shadow: 0 8px 18px rgba(99, 102, 241, 0.16);
  }

  .sort-btn:active { transform: translateY(0); }

  .sort-btn-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 8px;
    background: rgba(99, 102, 241, 0.16);
    color: #a5b4fc;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), background 0.2s, color 0.2s;
  }

  .sort-btn.sort-asc .sort-btn-icon {
    transform: rotate(180deg);
    background: rgba(16, 185, 129, 0.16);
    color: #6ee7b7;
  }

  .sort-btn.sort-asc {
    background: rgba(16, 185, 129, 0.08);
    border-color: rgba(16, 185, 129, 0.24);
    color: #bbf7d0;
  }

  .sort-btn.sort-asc:hover {
    background: rgba(16, 185, 129, 0.14);
    border-color: rgba(16, 185, 129, 0.4);
    box-shadow: 0 8px 18px rgba(16, 185, 129, 0.14);
  }

  .sort-btn-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.1rem;
    line-height: 1.1;
  }

  .sort-btn-label {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    opacity: 0.7;
  }

  .sort-btn-value {
    font-size: 0.82rem;
    font-weight: 700;
    color: inherit;
  }

  .source-picker-wrapper .sort-btn {
    flex-shrink: 0;
    min-height: var(--search-filter-button-height);
    padding: 0.4rem 0.9rem 0.4rem 0.7rem;
    font-size: inherit;
  }

  .search-bar-wrapper {
		position: relative;
		width: 100%;
		max-width: 92%;
    margin-bottom: 1rem;
	}

	.search-bar-wrapper input {
		width: 100%;
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: 12px;
		color: var(--text-primary);
		padding: 0.875rem 1rem 0.875rem 2.75rem;
		font-size: 1rem;
		outline: none;
		transition: all 0.2s;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
	}

	.search-bar-wrapper input:focus {
		border-color: var(--primary);
		box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15), 0 4px 20px rgba(0, 0, 0, 0.08);
		background: var(--bg-input);
	}

	.search-bar-wrapper input::placeholder { color: var(--text-muted); }

	.search-icon {
		position: absolute;
		left: 1rem;
		top: 50%;
		transform: translateY(-50%);
		color: var(--text-muted, #9ca3af);
		pointer-events: none;
		display: flex;
		align-items: center;
	}

	.search-filter-container {
		width: 100%;
		max-width: 100%;
		box-sizing: border-box;
	}

	.search-filter-inner {
		width: 100%;
		max-width: 100%;
		box-sizing: border-box;
		margin: 0;
	}

	.source-picker-wrapper {
		display: grid;
		width: 100%;
		max-width: 100%;
		gap: 0.5rem;
		margin-bottom: 1rem;
	}

	.source-picker-wrapper label {
		display: block;
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--text-muted, #9ca3af);
	}

	.source-picker-wrapper .source-file-picker {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
		max-width: 100%;
	}

	.source-picker-wrapper button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		min-height: var(--search-filter-button-height);
		background: var(--bg-hover);
		border: 1px solid var(--border-color);
		border-radius: 12px;
		color: var(--text-primary);
		padding: 0.4rem 1rem;
		font-size: 0.95rem;
		cursor: pointer;
		transition: all 0.2s;
	}

	.source-picker-wrapper button:hover {
		background: var(--bg-card);
		border-color: var(--primary);
	}

	.source-picker-wrapper .source-file-name {
		color: var(--text-muted, #9ca3af);
		font-size: 0.9rem;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		max-width: 240px;
	}

	.source-picker-wrapper .source-file-name-connected {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		height: var(--search-filter-button-height);
		box-sizing: border-box;
		padding: 0.25rem 0.72rem 0.25rem 0.6rem;
		border-radius: 12px;
		background: rgba(99, 102, 241, 0.08);
		border: 1px solid rgba(99, 102, 241, 0.22);
		color: var(--text-secondary);
		box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
		max-width: none;
	}

	.source-file-name-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.5rem;
		height: 1.5rem;
		border-radius: 7px;
		background: rgba(99, 102, 241, 0.16);
		color: #a5b4fc;
		flex-shrink: 0;
	}

	.source-file-name-copy {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.02rem;
		line-height: 1;
	}

	.source-file-name-label {
		font-size: 0.55rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-muted);
		opacity: 0.7;
	}

	.source-file-name-value {
		font-size: 0.76rem;
		font-weight: 700;
		color: inherit;
	}

	.filter-tags {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.filter-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: var(--bg-hover);
		border: 1px solid var(--border-color);
		color: var(--text-muted);
		min-height: var(--search-filter-button-height);
		padding: 0.35rem 1rem;
		border-radius: 15px;
		font-size: 0.65rem;
		font-weight: 500;
		cursor: pointer;
		transition: all 0.2s;
	}

	.filter-btn:hover {
		background: var(--bg-card);
		color: var(--text-primary);
		border-color: var(--border-focus);
	}

	.filter-btn.active {
		background: rgba(99, 102, 241, 0.12);
		border-color: rgba(99, 102, 241, 0.4);
		color: #a5b4fc;
	}

	/* Tag filter row */
	.tag-filter-row {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-top: 0.75rem;
		flex-wrap: wrap;
	}

	.tag-filter-label {
		font-size: 0.7rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.07em;
		color: var(--text-muted, #9ca3af);
		white-space: nowrap;
		flex-shrink: 0;
	}

	.tag-filter-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.tag-filter-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.2rem;
		background: rgba(99, 102, 241, 0.06);
		border: 1px solid rgba(99, 102, 241, 0.18);
		color: #a5b4fc;
		font-size: 0.72rem;
		font-weight: 600;
		padding: 0.28rem 0.65rem;
		border-radius: 20px;
		cursor: pointer;
		transition: all 0.18s;
	}

	.tag-filter-chip::before {
		content: '#';
		opacity: 0.55;
		font-size: 0.65rem;
	}

	.tag-filter-chip:hover {
		background: rgba(99, 102, 241, 0.14);
		border-color: rgba(99, 102, 241, 0.38);
		color: #c7d2fe;
	}

	.tag-filter-chip.active {
		background: rgba(99, 102, 241, 0.22);
		border-color: rgba(99, 102, 241, 0.55);
		color: #e0e7ff;
		box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.18);
	}
</style>
