---
import categories from '../data/categories.json';
---

<div class="search-filter-container">
	<div class="search-filter-inner">
		<div class="source-picker-wrapper">
			<label for="snippet-file-input">Choose dataset</label>
			<div class="source-file-picker">
				<button type="button" id="snippet-file-button">Browse JSON file</button>
				<span id="snippet-file-name" class="source-file-name">snippets.json</span>
				<button type="button" id="export-snippets-button" class="export-btn">Export JSON</button>


				<div class="sort-controls">
					<button type="button" id="sort-order-btn" title="Cambiar orden de snippets" class="sort-btn sort-desc" aria-pressed="false">
						<span class="sort-btn-icon" aria-hidden="true">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
								<path d="M12 5v14"></path>
								<path d="m7 10 5-5 5 5"></path>
								<path d="m7 14 5 5 5-5"></path>
							</svg>
						</span>
						<span class="sort-btn-copy">
							<span class="sort-btn-label">Orden</span>
							<span id="sort-order-text" class="sort-btn-value">Descendente</span>
						</span>
					</button>
				</div>
				<input type="file" id="snippet-file-input" accept=".json,application/json" hidden />
			</div>
		</div>

		<div class="search-bar-wrapper">
	<div class="search-icon">
		<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
	</div>
	<input 
		type="text" 
		id="search-input" 
		placeholder="Search by content, category or tag" 
		autocomplete="off"
	/>
</div>

<div class="filter-tags">
	{categories.map(cat => (
		<button 
			class={`filter-btn ${cat.id === 'all' ? 'active' : ''}`} 
			data-category={cat.id === 'all' ? 'all' : cat.value}
		>
			{cat.emoji} {cat.label}
		</button>
	))}
</div>

<!-- Tag filter row — populated dynamically by JS -->
<div class="tag-filter-row" id="tag-filter-row" hidden>
	<span class="tag-filter-label"># Tags</span>
	<div class="tag-filter-chips" id="tag-filter-chips"></div>
</div>
</div>
</div>

<style>
  .sort-controls {
    display: flex;
    margin-left: auto;
  }

  .sort-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    background: rgba(99, 102, 241, 0.08);
    border: 1px solid rgba(99, 102, 241, 0.22);
    color: #c7d2fe;
    padding: 0.55rem 0.9rem 0.55rem 0.7rem;
    border-radius: 12px;
    cursor: pointer;
    font-family: inherit;
    transition: background 0.2s, border-color 0.2s, box-shadow 0.2s, transform 0.15s;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
  }

  .sort-btn:hover {
    background: rgba(99, 102, 241, 0.14);
    border-color: rgba(99, 102, 241, 0.42);
    color: #e0e7ff;
    transform: translateY(-1px);
    box-shadow: 0 8px 18px rgba(99, 102, 241, 0.16);
  }

  .sort-btn:active {
    transform: translateY(0);
  }

  .sort-btn-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 8px;
    background: rgba(99, 102, 241, 0.16);
    color: #a5b4fc;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), background 0.2s, color 0.2s;
  }

  .sort-btn.sort-asc .sort-btn-icon {
    transform: rotate(180deg);
    background: rgba(16, 185, 129, 0.16);
    color: #6ee7b7;
  }

  .sort-btn.sort-asc {
    background: rgba(16, 185, 129, 0.08);
    border-color: rgba(16, 185, 129, 0.24);
    color: #bbf7d0;
  }

  .sort-btn.sort-asc:hover {
    background: rgba(16, 185, 129, 0.14);
    border-color: rgba(16, 185, 129, 0.4);
    box-shadow: 0 8px 18px rgba(16, 185, 129, 0.14);
  }

  .sort-btn-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.1rem;
    line-height: 1.1;
  }

  .sort-btn-label {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
  }

  .sort-btn-value {
    font-size: 0.82rem;
    font-weight: 700;
    color: inherit;
  }

  .source-picker-wrapper .sort-btn {
    flex-shrink: 0;
    padding: 0.55rem 0.9rem 0.55rem 0.7rem;
    font-size: inherit;
    background: rgba(99, 102, 241, 0.08);
    border: 1px solid rgba(99, 102, 241, 0.22);
    color: #c7d2fe;
  }

  .source-picker-wrapper .sort-btn:hover {
    background: rgba(99, 102, 241, 0.14);
    border-color: rgba(99, 102, 241, 0.42);
    color: #e0e7ff;
  }

  .source-picker-wrapper .sort-btn.sort-asc {
    background: rgba(16, 185, 129, 0.08);
    border-color: rgba(16, 185, 129, 0.24);
    color: #bbf7d0;
  }

  .source-picker-wrapper .sort-btn.sort-asc:hover {
    background: rgba(16, 185, 129, 0.14);
    border-color: rgba(16, 185, 129, 0.4);
  }

  .search-bar-wrapper {
		position: relative;
		width: 100%;
		max-width: 92%;
    margin-bottom: 1rem;
	}

	.search-bar-wrapper input {
		width: 100%;
		background: var(--bg-card, rgba(22, 24, 37, 0.7));
		border: 1px solid var(--border-color, rgba(255, 255, 255, 0.08));
		border-radius: 12px;
		color: var(--text-primary, #f3f4f6);
		padding: 0.875rem 1rem 0.875rem 2.75rem;
		font-size: 1rem;
		outline: none;
		transition: all 0.2s;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
	}

	.search-bar-wrapper input:focus {
		border-color: var(--primary, #6366f1);
		box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15), 0 4px 20px rgba(0, 0, 0, 0.1);
		background: rgba(22, 24, 37, 0.9);
	}

	.search-icon {
		position: absolute;
		left: 1rem;
		top: 50%;
		transform: translateY(-50%);
		color: var(--text-muted, #9ca3af);
		pointer-events: none;
		display: flex;
		align-items: center;
	}

	.search-filter-container {
		width: 100%;
		max-width: 100%;
		box-sizing: border-box;
	}

	.search-filter-inner {
		width: 100%;
		max-width: 100%;
		box-sizing: border-box;
		margin: 0;
	}

	.source-picker-wrapper {
		display: grid;
		width: 100%;
		max-width: 100%;
		gap: 0.5rem;
		margin-bottom: 1rem;
	}

	.source-picker-wrapper label {
		display: block;
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--text-muted, #9ca3af);
	}

	.source-picker-wrapper .source-file-picker {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
		max-width: 100%;
	}

	.source-picker-wrapper button {
		flex-shrink: 0;
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid var(--border-color, rgba(255, 255, 255, 0.08));
		border-radius: 12px;
		color: var(--text-primary, #f3f4f6);
		padding: 0.85rem 1rem;
		font-size: 0.95rem;
		cursor: pointer;
		transition: all 0.2s;
	}

	.source-picker-wrapper button:hover {
		background: rgba(255, 255, 255, 0.08);
	}

	.source-picker-wrapper .source-file-name {
		color: var(--text-muted, #9ca3af);
		font-size: 0.9rem;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		max-width: 240px;
	}

	.filter-tags {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.filter-btn {
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid var(--border-color, rgba(255, 255, 255, 0.08));
		color: var(--text-muted, #9ca3af);
		padding: 0.5rem 1rem;
		border-radius: 15px;
		font-size: 0.65rem;
		font-weight: 500;
		cursor: pointer;
		transition: all 0.2s;
	}

	.filter-btn:hover {
		background: rgba(255, 255, 255, 0.06);
		color: #ffffff;
		border-color: rgba(255, 255, 255, 0.15);
	}

	.filter-btn.active {
		background: rgba(99, 102, 241, 0.12);
		border-color: rgba(99, 102, 241, 0.4);
		color: #a5b4fc;
	}
</style>
