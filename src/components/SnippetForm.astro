---
import categories from '../data/categories.json';

// Filter out 'All' for form categories
const formCategories = categories.filter(cat => cat.id !== 'all');
---

<div class="glass-card">
	<h2>New Snippet</h2>
	<form id="snippet-form" class="snippet-form">
		<div class="form-group">
			<label for="snippet-text">Content</label>
			<textarea 
				id="snippet-text" 
				placeholder="Write or paste your text here..." 
				required
				rows="5"
			></textarea>
		</div>

		<div class="form-group">
			<label for="snippet-description">Description (Optional)</label>
			<input 
				type="text" 
				id="snippet-description" 
				placeholder="Add a short description..." 
				autocomplete="off"
			/>
		</div>

		<div class="form-group">
			<label>Tags (Optional)</label>
			<div class="tag-input-wrapper" id="tag-input-wrapper">
				<div class="tag-chips-row" id="tag-chips-row"></div>
				<input
					type="text"
					id="snippet-tags-input"
					placeholder="Type a tag and press Enter..."
					autocomplete="off"
				/>
			</div>
			<span class="tag-hint">Press <kbd>Enter</kbd> or <kbd>,</kbd> to add a tag</span>
		</div>

		<div class="form-group">
			<label for="snippet-category">Category</label>
			<select id="snippet-category">
				{formCategories.map(cat => (
					<option value={cat.value}>{cat.label}</option>
				))}
			</select>
		</div>

		<button type="submit" class="btn btn-primary">
			<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
			Save Snippet
		</button>
	</form>
</div>

<style>
	.glass-card {
		background: var(--bg-card, rgba(22, 24, 37, 0.7));
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border: 1px solid var(--border-color, rgba(255, 255, 255, 0.08));
		border-radius: 16px;
		padding: 1.75rem;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
	}

	h2 {
		font-family: var(--font-title, sans-serif);
		font-size: 1.25rem;
		font-weight: 700;
		margin: 0 0 1.5rem 0;
		color: var(--text-primary);
	}

	.snippet-form {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.form-group {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.form-group label {
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--text-muted);
	}

	.form-group textarea,
	.form-group select,
	.form-group input:not(#snippet-tags-input) {
		background: var(--bg-input);
		border: 1px solid var(--border-color);
		border-radius: 10px;
		color: var(--text-primary);
		padding: 0.875rem;
		font-family: inherit;
		font-size: 0.95rem;
		outline: none;
		transition: border-color 0.2s, box-shadow 0.2s, background 0.3s;
	}

	.form-group textarea::placeholder,
	.form-group input::placeholder {
		color: var(--text-muted);
		opacity: 0.6;
	}

	.form-group textarea:focus,
	.form-group select:focus,
	.form-group input:focus {
		border-color: var(--primary);
		box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		font-family: inherit;
		font-weight: 600;
		font-size: 0.9rem;
		padding: 0.75rem 1.25rem;
		border-radius: 10px;
		cursor: pointer;
		border: none;
		transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
		width: 100%;
	}

	.btn-primary {
		background: linear-gradient(135deg, var(--primary), #4f46e5);
		color: #ffffff;
		box-shadow: 0 4px 15px rgba(99, 102, 241, 0.25);
	}

	.btn-primary:hover {
		transform: translateY(-1px);
		box-shadow: 0 6px 20px rgba(99, 102, 241, 0.35);
		background: linear-gradient(135deg, #4f46e5, #4338ca);
	}

	.btn-primary:active { transform: translateY(1px); }

	/* Tag chip builder */
	.tag-input-wrapper {
		background: var(--bg-input);
		border: 1px solid var(--border-color);
		border-radius: 10px;
		padding: 0.5rem 0.75rem;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		transition: border-color 0.2s, box-shadow 0.2s;
	}

	.tag-input-wrapper:focus-within {
		border-color: var(--primary);
		box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
	}

	.tag-chips-row { display: flex; flex-wrap: wrap; gap: 0.375rem; }
	.tag-chips-row:empty { display: none; }

	:global(.form-tag-chip) {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		background: rgba(99, 102, 241, 0.12);
		border: 1px solid rgba(99, 102, 241, 0.25);
		color: #a5b4fc;
		font-size: 0.75rem;
		font-weight: 600;
		padding: 0.2rem 0.5rem;
		border-radius: 20px;
	}

	:global(.form-tag-chip)::before { content: '#'; opacity: 0.6; font-size: 0.65rem; }

	:global(.form-tag-remove) {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1rem;
		height: 1rem;
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid rgba(165, 180, 252, 0.18);
		border-radius: 999px;
		color: rgba(199, 210, 254, 0.8);
		cursor: pointer;
		padding: 0;
		line-height: 1;
		font-size: 0.72rem;
		font-weight: 700;
		margin-left: 0.1rem;
		flex-shrink: 0;
		transition: color 0.15s, background 0.15s, border-color 0.15s, transform 0.15s;
	}

	:global(.form-tag-remove:hover) {
		color: #fecaca;
		background: rgba(239, 68, 68, 0.16);
		border-color: rgba(239, 68, 68, 0.35);
		transform: scale(1.05);
	}

	#snippet-tags-input {
		background: transparent;
		border: none;
		outline: none;
		color: var(--text-primary);
		font-family: inherit;
		font-size: 0.9rem;
		padding: 0.25rem 0;
		width: 100%;
	}

	#snippet-tags-input::placeholder { color: var(--text-muted); opacity: 0.6; }

	.tag-hint {
		font-size: 0.7rem;
		color: var(--text-muted);
		opacity: 0.7;
		margin-top: -0.5rem;
	}

	.tag-hint kbd {
		background: var(--bg-hover);
		border: 1px solid var(--border-color);
		border-radius: 4px;
		padding: 0.05rem 0.35rem;
		font-family: inherit;
		font-size: 0.65rem;
		color: var(--text-muted);
	}
</style>
