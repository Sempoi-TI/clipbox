			<label for="snippet-text">Content</label>
			<textarea 
				id="snippet-text" 
				placeholder="Write or paste your text here..." 
				required
				rows="5"
			></textarea>
		</div>

		<div class="form-group">
			<label for="snippet-category">Categoría</label>
